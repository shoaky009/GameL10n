<Application x:Class="GameL10n.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" /></ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="#F4F7FB" />
          <SolidColorBrush x:Key="TaskSurfaceBrush" Color="#EAF2FC" />
          <SolidColorBrush x:Key="EditorSurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="EditorBorderBrush" Color="#DCE5F0" />
          <SolidColorBrush x:Key="MetadataTextBrush" Color="#3B6897" />
          <SolidColorBrush x:Key="WarningTextBrush" Color="#946200" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="#181E27" />
          <SolidColorBrush x:Key="TaskSurfaceBrush" Color="#233248" />
          <SolidColorBrush x:Key="EditorSurfaceBrush" Color="#202833" />
          <SolidColorBrush x:Key="EditorBorderBrush" Color="#39485D" />
          <SolidColorBrush x:Key="MetadataTextBrush" Color="#A5C9F0" />
          <SolidColorBrush x:Key="WarningTextBrush" Color="#F5CA80" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
          <SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="TaskSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="EditorSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="EditorBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
          <SolidColorBrush x:Key="MetadataTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
          <SolidColorBrush x:Key="WarningTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <Color x:Key="SystemAccentColor">#2563A6</Color>
      <Color x:Key="SystemAccentColorDark1">#20588F</Color>
      <Color x:Key="SystemAccentColorDark2">#1C4D7B</Color>
      <Color x:Key="SystemAccentColorDark3">#183F67</Color>
      <Color x:Key="SystemAccentColorLight1">#4C85BE</Color>
      <Color x:Key="SystemAccentColorLight2">#90B7DD</Color>
      <Color x:Key="SystemAccentColorLight3">#E1EDFA</Color>
    </ResourceDictionary>
  </Application.Resources>
</Application>
