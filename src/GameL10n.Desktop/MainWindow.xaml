<Window x:Class="GameL10n.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GameL10n">
  <Grid x:Name="RootGrid" RequestedTheme="Default" Background="{ThemeResource WorkspaceBackgroundBrush}" Padding="20" ColumnSpacing="20">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Grid RowSpacing="16">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <TextBlock Text="游戏项目" FontSize="22" FontWeight="SemiBold" />
      <StackPanel Grid.Row="1" Spacing="8">
        <Button x:Name="BrowseButton" Content="添加游戏" Click="Browse_Click" HorizontalAlignment="Stretch" ToolTipService.ToolTip="选择包含游戏程序和资源的安装目录。添加后自行选择识别方式；重新添加同一目录可继续使用保留的项目数据。" />
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <ToggleButton x:Name="MultiSelectGamesButton" Content="多选" Checked="MultiSelectGames_Changed" Unchecked="MultiSelectGames_Changed" HorizontalAlignment="Stretch" />
          <Button x:Name="RemoveGamesButton" Grid.Column="1" Content="移除" Click="RemoveGames_Click" IsEnabled="False" ToolTipService.ToolTip="默认只从列表移除并保留项目数据；可在确认框中选择同时删除。多选时仅处理当前选中的项目。" />
        </Grid>
      </StackPanel>
      <Grid Grid.Row="3">
        <ListView x:Name="GameList" SelectionMode="Single" SelectionChanged="GameList_SelectionChanged" IsItemClickEnabled="True" ItemClick="GameList_ItemClick" HorizontalContentAlignment="Stretch" AutomationProperties.Name="游戏项目">
          <ListView.ItemTemplate><DataTemplate><StackPanel Spacing="4" Padding="0,6">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Status}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Status}" />
            <TextBlock Text="{Binding PathLabel}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding PathLabel}" />
          </StackPanel></DataTemplate></ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="GameEmptyText" Text="添加游戏目录，开始识别和翻译。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,16,0,0" />
      </Grid>
      <StackPanel Grid.Row="2" Spacing="8">
        <TextBox x:Name="ProjectSearchBox" PlaceholderText="搜索名称或路径" TextChanged="ProjectSearch_TextChanged" AutomationProperties.Name="搜索游戏项目" ToolTipService.ToolTip="搜索只筛选项目列表，当前项目和后台任务继续保留。运行或排队中的项目优先显示。" />
        <TextBlock x:Name="ActiveTasksText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
      <StackPanel Grid.Row="4" Spacing="8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
        <TextBlock Text="全局" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="12,0,0,0" />
        <ListView x:Name="GlobalNavigation" SelectionMode="Single" SelectionChanged="GlobalNavigation_SelectionChanged" AutomationProperties.Name="全局导航">
          <ListViewItem x:Name="ApiNavigationItem" Tag="apis" Content="API 与任务默认值" />
          <ListViewItem Tag="catalog" Content="全局引擎库" />
          <ListViewItem Tag="application" Content="程序设置" />
        </ListView>
      </StackPanel>
    </Grid>
    <Grid Grid.Column="1" RowSpacing="16">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid x:Name="WindowActivityPanel" ColumnSpacing="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <ProgressRing x:Name="WindowActivityRing" IsActive="True" Width="20" Height="20" />
        <TextBlock x:Name="WindowActivityText" Grid.Column="1" Text="正在加载游戏项目…" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
      </Grid>
      <Grid x:Name="ProjectView" Grid.Row="1" RowSpacing="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Spacing="6">
      <TextBlock x:Name="GameNameText" Text="选择或添加游戏" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
      <TextBlock Text="识别引擎、翻译校对，再生成可安装的汉化补丁" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

    </StackPanel>
    <Border Grid.Row="1" Background="{ThemeResource TaskSurfaceBrush}" CornerRadius="6" Padding="14,10">
      <Grid RowSpacing="6" ColumnSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="4">
          <TextBlock x:Name="StageText" Text="等待导入" FontWeight="SemiBold"/>
          <TextBlock x:Name="CountsText" FontSize="12" Text="—" TextWrapping="Wrap"/>
          <TextBlock x:Name="TaskMessageText" FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button x:Name="TranslateButton" Content="开始全量翻译" Click="Translate_Click" IsEnabled="False" ToolTipService.ToolTip="复用已有有效译文，处理未完成文本。续译可沿用上次选区；全量翻译只保存译文，试译任务还会生成补丁。"/>
          <Button x:Name="CancelButton" Content="暂停" Click="Cancel_Click" IsEnabled="False" ToolTipService.ToolTip="暂停当前项目的任务，保留已保存结果和进度。其他游戏的后台任务继续运行。"/>
          <Button Content="任务详情"><Button.Flyout><Flyout><ScrollViewer MaxHeight="420" Width="640" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="8">
      <Grid x:Name="ProjectActivityPanel" ColumnSpacing="12" Margin="0,8,0,0" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <ProgressRing x:Name="ProjectActivityRing" Width="24" Height="24" IsActive="False" />
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock x:Name="ProjectActivityTitle" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
          <TextBlock x:Name="ProjectActivityMessage" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </Grid>
            <TextBlock x:Name="TaskApiSummaryText" FontSize="12" TextWrapping="Wrap"/>
            <TextBlock Text="切换项目后任务继续在后台运行；暂停或重新打开程序后可继续翻译，已完成的有效译文会复用。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Expander Header="续译与失败处理" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="12">
                <TextBlock Text="译文按原文、上下文、文本类型、目标语言、风格和相关术语匹配。规则相符时复用已有结果，无需重新请求翻译 API。" TextWrapping="Wrap"/>
                <TextBlock Text="模型拒绝处理内容时尝试翻译 API 链的下一项；继续相同任务时跳过已拒绝的 API。网络、限流、超时或返回格式错误会在当前 API 上重试，每隔 10 秒、最多重试 5 次，等待时可暂停。" TextWrapping="Wrap"/>
                <TextBlock Text="全量翻译会保存成功译文并继续后续文本。失败项可用“翻译失败”筛选查看原因，继续全量翻译会处理未完成文本。需要时可向 API 链追加配置。" TextWrapping="Wrap"/>
                <TextBlock Text="试译、所选文本重新翻译和单条候选在出错时停止，已完成结果会保留。继续上次试译或重译时可选择原选区。" TextWrapping="Wrap"/>
              </StackPanel>
            </Expander>
          </StackPanel>

          </ScrollViewer></Flyout></Button.Flyout></Button>
          <Button x:Name="GeneratePatchButton" Content="生成补丁" Click="GeneratePatch_Click" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" ToolTipService.ToolTip="使用已保存译文生成游戏文件，不调用翻译 API。可选择全部、所选或仅已校对的译文；其余文本保留原文。"/>
        </StackPanel>
        <ProgressBar x:Name="TaskProgress" Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100" Value="0"/>
        <InfoBar x:Name="TaskErrorInfo" Grid.Row="2" Grid.ColumnSpan="2" IsOpen="False" IsClosable="False" Severity="Error" Title="任务需要处理"/>

      </Grid>
    </Border>

    <TabView x:Name="ProjectTabs" SelectionChanged="ProjectTabs_SelectionChanged" Grid.Row="2" IsAddTabButtonVisible="False" CanReorderTabs="False" CanDragTabs="False" TabWidthMode="SizeToContent">
      <TabViewItem x:Name="RecognitionTab" Header="识别与适配" IsClosable="False">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="20" Padding="16,20,16,12">
            <TextBlock Text="游戏资源" FontSize="20" FontWeight="SemiBold"/>
    <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBox x:Name="GamePathBox" Header="游戏安装目录" IsReadOnly="True" PlaceholderText="从左侧添加游戏" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
        <Button x:Name="OpenGameDataButton" Content="项目文件" Click="OpenGameData_Click" ToolTipService.ToolTip="打开此项目的译文、补丁和日志等数据文件夹。" />
        <Button x:Name="OpenGameDirectoryButton" Content="游戏目录" Click="OpenGameDirectory_Click" IsEnabled="False" ToolTipService.ToolTip="打开当前游戏的安装文件夹。" />
      </StackPanel>
      <Button x:Name="AnalyzeButton" Grid.Column="2" Content="常规识别" VerticalAlignment="Bottom" Click="Analyze_Click" ToolTipService.ToolTip="检查当前游戏资源并更新文本，不调用分析 API。日常打开项目直接加载已保存结果；游戏更新后请重新识别。" />
      <Button x:Name="AdaptButton" Grid.Column="3" Content="智能识别与适配" VerticalAlignment="Bottom" Click="Adapt_Click" ToolTipService.ToolTip="使用分析 API 调查资源、开发和验证引擎适配器。已识别的游戏可继续补齐遗漏文字，复用已有源码和译文。" />
    </Grid>
            <InfoBar x:Name="GameInfoBar" IsOpen="True" IsClosable="False" Severity="Informational" Title="尚未导入游戏" Message="识别后可查看文本数量与适配结果。" />
            <StackPanel Spacing="8">
              <Button x:Name="EngineReviewButton" Content="总结" Click="EngineReview_Click" HorizontalAlignment="Left" ToolTipService.ToolTip="复用本项目智能适配的分析 API、思考等级、Token 预算和模型轮数，从本项目提炼同类引擎的可复用经验，保存到全局库。证据未变化时复用上次总结；没有优化空间时不会强行生成内容。" />
              <TextBlock Text="总结与智能适配共用分析 API 和预算设置，未单独设置时使用全局默认。证据未变化时复用上次结果。经验供所有项目共享，可在全局引擎库的“相关经验”中停用。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <Expander x:Name="EngineReviewPanel" Header="引擎经验总结" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="Collapsed">
                <StackPanel Spacing="8">
                  <TextBlock x:Name="EngineReviewSummaryText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                  <TextBlock x:Name="EngineReviewUsageText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
              </Expander>
            </StackPanel>
            <StackPanel x:Name="AdaptationPanel" Spacing="8" Visibility="Collapsed">
              <StackPanel Spacing="4">
                <TextBlock x:Name="AdaptationProgressTitle" Text="适配进展" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="AdaptationProgressText" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.Name="适配进展说明" />
                <TextBlock x:Name="AdaptationProgressTimeText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <TextBlock x:Name="AdaptationBreakthroughText" TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
              <TextBlock x:Name="AdaptationUsageText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <TextBlock x:Name="AdaptationBlockerText" TextWrapping="Wrap" Visibility="Collapsed" />
              <Expander Header="查看适配详情" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <TextBlock x:Name="AdaptationSummaryText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
              </Expander>
            </StackPanel>

            <TextBlock x:Name="RecognitionDetailsText" Text="添加游戏后先匹配已有适配器，未匹配时可使用智能识别。" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
            <TextBlock Text="常规识别匹配已有引擎，不调用分析 API；智能适配会调用分析 API 开发和验证适配器。打开已有项目只加载保存的结果，游戏更新后再重新识别；失败或取消会保留上一次成功结果。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Expander Header="支持范围与注意事项" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="12">
                <TextBlock Text="可翻译范围以本次提取结果为准，图片和视频内的文字不在提取范围内。确认支持后，先选少量容易在游戏中找到的文本试译；发现遗漏可继续智能适配，补充遗漏位置。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="RecognitionWarningsText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
              </StackPanel>
            </Expander>
            <Button x:Name="OpenWorkbenchButton" Content="查看文本并试译" Click="OpenWorkbench_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left"/>
          </StackPanel>
        </ScrollViewer>
      </TabViewItem>
      <TabViewItem x:Name="WorkbenchTab" Header="翻译与校对" IsClosable="False">
        <Grid Padding="0,12,0,0" RowSpacing="8">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="125"/><ColumnDefinition Width="125"/></Grid.ColumnDefinitions>
            <TextBox x:Name="TextSearchBox" PlaceholderText="搜索原文、译文、角色或位置" TextChanged="TextSearch_TextChanged" AutomationProperties.Name="搜索项目文本" ToolTipService.ToolTip="Ctrl+K 搜索。筛选和翻页不会清空已勾选的文本。"/>
            <ComboBox x:Name="ResourceFilterBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="TextFilter_Changed" AutomationProperties.Name="脚本资源筛选"/>
            <ComboBox x:Name="KindFilterBox" Grid.Column="2" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="TextFilter_Changed" AutomationProperties.Name="文本类型">
              <ComboBoxItem Content="全部类型" Tag="all"/><ComboBoxItem Content="对白 / 旁白" Tag="dialogue"/><ComboBoxItem Content="角色名" Tag="name"/><ComboBoxItem Content="选项" Tag="choice"/>
              <ComboBoxItem Content="菜单 / 界面" Tag="ui"/><ComboBoxItem Content="物品 / 装备" Tag="item"/><ComboBoxItem Content="技能 / 天赋" Tag="skill"/><ComboBoxItem Content="提示 / 说明" Tag="system"/>
            </ComboBox>
            <ComboBox x:Name="StatusFilterBox" Grid.Column="3" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="TextFilter_Changed" AutomationProperties.Name="校对状态" ToolTipService.ToolTip="选择“翻译失败”并点击文本可查看原因；继续全量翻译时会复用成功译文，处理未完成文本。">
              <ComboBoxItem Content="全部状态" Tag="all"/><ComboBoxItem Content="未翻译" Tag="missing"/><ComboBoxItem Content="翻译失败" Tag="failed"/><ComboBoxItem Content="待校对" Tag="pending"/><ComboBoxItem Content="已编辑" Tag="edited"/><ComboBoxItem Content="已校对" Tag="reviewed"/><ComboBoxItem Content="格式问题" Tag="invalid"/>
            </ComboBox>
          </Grid>
          <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="WorkbenchSummaryText" Text="识别完成后显示项目文本。" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <DropDownButton Content="选择与批量操作" ToolTipService.ToolTip="勾选跨页、筛选和重启保留。“全选匹配文本”包含当前筛选下的所有页面；列表按资源提取顺序排列，可能与剧情顺序不同。"><DropDownButton.Flyout><MenuFlyout>
                <MenuFlyoutItem Text="选中本页" Click="SelectPageTexts_Click"/>
                <MenuFlyoutItem Text="全选匹配文本" Click="SelectMatchingTexts_Click"/>
                <MenuFlyoutItem Text="清空选择" Click="ClearSelectedTexts_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem x:Name="BulkReviewMenuItem" Text="批量确认校对" Click="BulkReview_Click" ToolTipService.ToolTip="确认所选的有效译文，跳过未翻译和格式有问题的文本。请先人工检查含义和表达。"/>
              </MenuFlyout></DropDownButton.Flyout></DropDownButton>
              <Button x:Name="TrialButton" Content="翻译所选" Click="Trial_Click" IsEnabled="False" ToolTipService.ToolTip="仅翻译勾选文本并保存译文，已有有效译文会复用。此操作不生成补丁。"/>
              <Button x:Name="RetranslateSelectedButton" Content="重新翻译所选" Click="RetranslateSelected_Click" IsEnabled="False" ToolTipService.ToolTip="重新调用翻译 API；确认后替换所选文本，包括手工编辑和已校对译文。重译期间暂停本项目的编辑与校对。"/>
              <Button x:Name="TrialPatchButton" Content="试译并生成补丁" Click="TrialPatch_Click" IsEnabled="False" ToolTipService.ToolTip="翻译所选文本并生成试译补丁。未选文本保留原文，即使它们已有译文缓存。"/>
            </StackPanel>
          </Grid>
          <TextBlock Grid.Row="2" Text="翻译只保存译文；试译补丁仅使用所选文本，其余保留原文。勾选会跨页保留，可用“仅显示已选文本”复查范围。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          <Grid x:Name="WorkbenchLayout" Grid.Row="3" ColumnSpacing="12" RowSpacing="12" SizeChanged="WorkbenchLayout_SizeChanged">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="EditorColumn" Width="380"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="EditorRow" Height="0"/></Grid.RowDefinitions>
            <Grid RowSpacing="6">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <CheckBox x:Name="OnlySelectedTextsBox" Content="仅显示已选文本" Click="OnlySelectedTexts_Click"/>
              <ListView x:Name="TextRowsList" Grid.Row="1" SelectionMode="Single" SelectionChanged="TextRows_SelectionChanged" HorizontalContentAlignment="Stretch" AutomationProperties.Name="原文与译文">
                <ListView.ItemTemplate><DataTemplate>
                  <Grid ColumnSpacing="8" Padding="0,8" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <CheckBox Width="24" MinWidth="24" IsChecked="{Binding Selected, Mode=OneWay}" Tag="{Binding}" Click="TextRowCheck_Click" VerticalAlignment="Top" AutomationProperties.Name="选择这条文本"/>
                    <StackPanel Grid.Column="1" Spacing="5">
                      <TextBlock Text="{Binding Location}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Location}"/>
                      <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Source}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{Binding Preview}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"/>
                      </Grid>
                      <TextBlock Text="{Binding Metadata}" FontSize="11" Foreground="{ThemeResource MetadataTextBrush}"/>
                    </StackPanel>
                  </Grid>
                </DataTemplate></ListView.ItemTemplate>
              </ListView>
              <TextBlock x:Name="WorkbenchEmptyText" Grid.Row="1" Text="正在加载文本…" TextWrapping="Wrap" Padding="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="PreviousTextsButton" Content="上一页" Click="PreviousTexts_Click"/>
                <TextBlock x:Name="TextsPageText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                <Button x:Name="NextTextsButton" Grid.Column="2" Content="下一页" Click="NextTexts_Click"/>
              </Grid>
            </Grid>
            <Border x:Name="EditorPanel" Grid.Column="1" Background="{ThemeResource EditorSurfaceBrush}" BorderBrush="{ThemeResource EditorBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
              <Grid RowSpacing="10">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="文本校对" FontWeight="SemiBold" FontSize="18"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"><Button Content="↑" Click="PreviousText_Click" AutomationProperties.Name="上一条文本" ToolTipService.ToolTip="上一条文本（Alt+↑）"/><Button Content="↓" Click="NextText_Click" AutomationProperties.Name="下一条文本" ToolTipService.ToolTip="下一条文本（Alt+↓）"/></StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Spacing="12">
                    <TextBlock x:Name="EditorLocationText" Text="选择一条文本开始校对" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                    <TextBlock x:Name="EditorSourceText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                    <Expander Header="相邻文本与上下文" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ToolTipService.ToolTip="按资源提取顺序显示相邻文本；位置由适配器提供，未必是脚本行号或剧情播放顺序。"><TextBlock x:Name="EditorContextText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12"/></Expander>
                    <TextBlock x:Name="PreviousEditText" Visibility="Collapsed" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" Foreground="{ThemeResource WarningTextBrush}"/>
                    <TextBox x:Name="TranslationEditorBox" Header="译文" PlaceholderText="输入译文，稍停后自动保存" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="260" TextChanged="TranslationEditor_TextChanged" IsEnabled="False"/>
                    <TextBlock Text="输入后稍停即自动保存。修改会取消本条校对确认；普通翻译期间也可编辑，手工修改优先保留。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="EditorSaveText" FontSize="12" Foreground="{ThemeResource MetadataTextBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    <InfoBar x:Name="EditorValidationInfo" IsOpen="False" IsClosable="False"/>

                    <Button x:Name="MarkUnreviewedButton" Content="标为待校对" Click="MarkUnreviewed_Click" HorizontalAlignment="Left" Visibility="Collapsed"/>
                    <Expander x:Name="ModelDraftExpander" Header="查看模型初稿" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><TextBlock x:Name="ModelDraftText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></Expander>
                    <TextBlock Text="相关术语 · 点击可插入译文" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <StackPanel x:Name="EditorTermsPanel" Spacing="4"/>
                    <TextBlock x:Name="EditorTermsEmptyText" Text="当前文本没有匹配的术语。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Spacing="8"><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="SaveEditButton" Content="保存译文" Click="SaveEdit_Click" ToolTipService.ToolTip="立即保存当前编辑（Ctrl+S）。切换项目或关闭程序前也会保存。"/><Button x:Name="CandidateButton" Content="重新翻译并对比" Click="Candidate_Click" ToolTipService.ToolTip="生成新候选会调用翻译 API；采用后才替换当前译文。“稍后处理”会保留候选，重启后可继续对比。"/></StackPanel>
                <Button x:Name="ConfirmReviewButton" Content="确认校对，下一条" Click="ConfirmReview_Click" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="记录人工确认并进入下一条（Ctrl+Enter）。请先检查含义、角色名和控制标记；继续编辑会取消确认。"/>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </TabViewItem>
      <TabViewItem x:Name="PatchTab" Header="补丁与验证" IsClosable="False">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="16" Padding="0,20,8,12">
            <TextBlock Text="生成的汉化文件可独立安装和运行，游戏运行不依赖适配器或本工具。需要替换的文件会先备份为 .bak；已有备份不会覆盖。" TextWrapping="Wrap" />
            <Button x:Name="BuildSavedPatchButton" Content="从已保存译文生成补丁" Click="GeneratePatch_Click" HorizontalAlignment="Left" ToolTipService.ToolTip="不调用翻译 API。可使用全部、所选或仅已校对的译文，未包含的文本保留原文。"/>
            <InfoBar x:Name="PatchChangedInfo" IsOpen="False" IsClosable="False" Severity="Warning" Title="补丁包含的译文已修改" Message="当前补丁保留生成时的内容。要使用修改后的译文，请重新生成。"/>
            <TextBlock x:Name="PatchScopeText" Text="尚未生成补丁。可先选择少量文本试译，检查游戏中的显示效果。" TextWrapping="Wrap" FontWeight="SemiBold" />
            <TextBox x:Name="PatchPathBox" Header="补丁目录" IsReadOnly="True" PlaceholderText="翻译完成后生成" />
            <TextBlock x:Name="InstallTargetText" Text="安装位置：上方选择的游戏目录" TextWrapping="Wrap" />
            <TextBlock Text="安装或恢复前先关闭游戏和汉化启动器。安装会写入上方游戏目录，无需手工复制文件。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <InfoBar x:Name="PatchInstallInfo" IsOpen="False" IsClosable="True" />
            <TextBlock x:Name="LaunchText" Text="启动方式将在生成补丁后显示。" TextWrapping="Wrap" />
            <TextBlock x:Name="ValidationText" Text="结构校验：未执行　游戏运行验证：未执行" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button x:Name="InstallButton" Content="安装汉化补丁" Style="{StaticResource AccentButtonStyle}" Click="Install_Click" IsEnabled="False" />
              <Button x:Name="ShowPatchTextsButton" Content="查看本次文本" Click="ShowPatchTexts_Click" ToolTipService.ToolTip="查看生成这份补丁时实际使用的译文；后续编辑需要重新生成补丁才会生效。"/>
              <Button x:Name="OpenPatchButton" Content="打开补丁目录" Click="OpenPatch_Click" IsEnabled="False" />
              <Button x:Name="RestoreButton" Content="恢复原版" Click="Restore_Click" IsEnabled="False" ToolTipService.ToolTip="根据项目安装记录恢复原文件，移除工具新增的补丁文件。遇到游戏更新或外部修改时会保留文件并提示冲突。" />
            </StackPanel>
            <Expander Header="安装与恢复须知" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="12">
                <TextBlock Text="安装前会核对游戏资源版本，只写入补丁声明的文件；原文件备份为 .bak，已有备份会保留。游戏已更新或文件被其他程序修改时，请先处理提示的冲突。" TextWrapping="Wrap"/>
                <TextBlock Text="安装或恢复中断后，关闭游戏并再次点击同一按钮即可继续。请保留安装记录和原文件备份，程序会核对文件后恢复操作。" TextWrapping="Wrap"/>
                <TextBlock Text="自动恢复原版需要项目数据中的安装记录，以及游戏目录中的原文件备份。备份时请同时保留数据保存目录和游戏目录中的 .bak 文件；删除项目数据后将无法通过该项目自动恢复。" TextWrapping="Wrap"/>
              </StackPanel>
            </Expander>
            <TextBlock Text="游戏内显示验证" FontWeight="SemiBold"/>
            <TextBlock x:Name="RuntimeCheckText" Text="尚未记录游戏内验证结果。结构校验通过不代表中文显示已验证。" TextWrapping="Wrap"/>
            <TextBlock Text="按上方启动方式进入试译片段，检查字体、乱码、换行、角色名和选项；完整验证还需检查分支与存档。下方记录只对应当前补丁。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="RecordRuntimePassedButton" Content="记录：显示正常" Tag="passed" Click="RecordRuntime_Click"/><Button x:Name="RecordRuntimeFailedButton" Content="记录：存在问题" Tag="failed" Click="RecordRuntime_Click"/></StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabViewItem>
      <TabViewItem Header="项目设置" IsClosable="False">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="16" Padding="0,20,8,12" HorizontalAlignment="Stretch">
            <TextBlock Text="API 和适配预算可跟随全局默认；取消勾选可为当前项目单独设置。已有独立设置会保留，术语与翻译风格始终属于当前项目。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Content="管理全局 API 与任务默认值" Click="ManageApis_Click" HorizontalAlignment="Left" />
            <CheckBox x:Name="UseGlobalAnalysisApiBox" Content="分析 API 使用全局默认" Click="ApiInheritance_Click" />
            <ComboBox x:Name="AnalysisApiBox" Header="智能识别与适配 API" DisplayMemberPath="Name" PlaceholderText="选择已保存的 API 配置" HorizontalAlignment="Stretch" SelectionChanged="ApiPurpose_SelectionChanged" />
            <StackPanel Spacing="8">
              <TextBlock Text="文本翻译 API 链" FontWeight="SemiBold" />
              <CheckBox x:Name="UseGlobalTranslationApiBox" Content="翻译 API 链使用全局默认" Click="ApiInheritance_Click" />
              <TextBlock Text="从上到下尝试；仅在模型拒绝处理内容时交给下一项。网络、429、超时和格式错误会在当前 API 重试。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <ListView x:Name="TranslationChainList" DisplayMemberPath="Name" SelectionMode="Single" MaxHeight="160" SelectionChanged="TranslationChain_SelectionChanged" AutomationProperties.Name="翻译 API 顺序，第一项优先" />
              <TextBlock x:Name="TranslationChainEmptyText" Text="尚未配置翻译 API。请设置全局默认，或取消跟随后在此添加。" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="MoveTranslationUpButton" Content="上移" Click="MoveTranslationUp_Click" />
                <Button x:Name="MoveTranslationDownButton" Content="下移" Click="MoveTranslationDown_Click" />
                <Button x:Name="RemoveTranslationApiButton" Content="从链中移除" Click="RemoveTranslationApi_Click" />
              </StackPanel>
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ComboBox x:Name="TranslationCandidateBox" Header="添加翻译 API" DisplayMemberPath="Name" PlaceholderText="选择已保存的 API 配置" HorizontalAlignment="Stretch" SelectionChanged="TranslationChain_SelectionChanged" />
                <Button x:Name="AddTranslationApiButton" Grid.Column="1" Content="添加到链末尾" VerticalAlignment="Bottom" Click="AddTranslationApi_Click" />
              </Grid>
            </StackPanel>

            <InfoBar x:Name="ApiSettingsInfo" IsOpen="False" IsClosable="True" />
            <Expander Header="智能适配预算" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="12">
                <CheckBox x:Name="UseGlobalAdaptationLimitsBox" Content="适配预算与轮数使用全局默认" Click="AdaptationInheritance_Click" />
                <NumberBox x:Name="ProjectTokenBudgetBox" Header="每次适配 Token 预算" Value="1000000" Minimum="1000" Maximum="20000000" SpinButtonPlacementMode="Inline" />
                <NumberBox x:Name="ProjectMaximumTurnsBox" Header="每次最多模型轮数" Value="60" Minimum="1" Maximum="400" SpinButtonPlacementMode="Inline" />
                <TextBlock Text="每次开始或继续适配时使用。任一上限达到后暂停并保存进度，不影响已完成的工作。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </Expander>
            <Expander Header="翻译语言与术语" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="16">
                <TextBox x:Name="LanguageBox" Header="目标语言" Text="简体中文" />
                <TextBox x:Name="StyleBox" Header="翻译风格" Text="自然流畅，保留人物语气、情绪和原文含义。" TextWrapping="Wrap" />
                <TextBox x:Name="TerminologyBox" Header="术语表（每行：原文=译文）" PlaceholderText="角色原名=中文译名" AcceptsReturn="True" MinHeight="100" TextWrapping="Wrap" />
                <TextBlock Text="已有译文按目标语言、风格和相关术语匹配复用；更改术语只影响相关文本的译文复用。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <NumberBox x:Name="BatchSizeBox" Header="每批文本数" Value="24" Minimum="1" Maximum="80" SpinButtonPlacementMode="Inline" />
              </StackPanel>
            </Expander>
            <Button Content="保存项目设置" Click="SaveSettings_Click" HorizontalAlignment="Left" />
          </StackPanel>
        </ScrollViewer>
      </TabViewItem>
    </TabView>
    <Grid Grid.Row="3" RowSpacing="6">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid>
        <TextBlock Text="实时日志" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Button Content="打开日志目录" Click="OpenLogs_Click" HorizontalAlignment="Right" Padding="10,4" FontSize="12"/>
      </Grid>
      <Border Grid.Row="1" Background="{ThemeResource EditorSurfaceBrush}" BorderBrush="{ThemeResource EditorBorderBrush}" BorderThickness="1" CornerRadius="4">
        <ScrollViewer x:Name="LogScrollViewer" Height="110" Padding="10,6" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="LogScrollViewer_SizeChanged" AutomationProperties.Name="当前项目实时日志">
          <TextBlock x:Name="LogBox" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12"/>
        </ScrollViewer>
      </Border>
    </Grid>
      </Grid>
      <Grid x:Name="ApiProfilesView" Grid.Row="1" Visibility="Collapsed" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Spacing="6">
          <TextBlock Text="API 与任务默认值" FontSize="26" FontWeight="SemiBold" />
          <TextBlock Text="全局默认供新项目及选择跟随的项目使用。项目可独立覆盖；修改后用于后续任务，无需重启。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="16" Padding="0,8,8,12">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button x:Name="AddApiButton" Content="新增 API 配置" Click="AddApi_Click" Style="{StaticResource AccentButtonStyle}" />
              <Button x:Name="EditApiButton" Content="编辑所选配置" Click="EditApi_Click" IsEnabled="False" />
              <Button x:Name="DeleteApiButton" Content="删除所选配置" Click="DeleteApi_Click" IsEnabled="False" />
            </StackPanel>
            <TextBlock x:Name="ApiEmptyText" Text="还没有 API 配置。第一份配置将同时作为分析和翻译的全局默认。" TextWrapping="Wrap" />
            <ListView x:Name="ApiProfileList" SelectionMode="Single" MaxHeight="210" SelectionChanged="ApiProfileList_SelectionChanged" AutomationProperties.Name="已保存的 API 配置">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <StackPanel Spacing="4" Padding="0,8" ToolTipService.ToolTip="{Binding Endpoint}">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Description}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
            <InfoBar x:Name="SharedApiInfo" IsOpen="False" IsClosable="True" />
            <Expander Header="默认 API 用途" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="12">
                <ComboBox x:Name="DefaultAnalysisApiBox" Header="默认智能识别与适配 API" DisplayMemberPath="Name" PlaceholderText="选择已保存的 API 配置" HorizontalAlignment="Stretch" SelectionChanged="ApiPurpose_SelectionChanged" />
                <TextBlock Text="默认文本翻译 API 链" FontWeight="SemiBold" />
                <TextBlock Text="从上到下尝试；仅在模型拒绝处理内容时交给下一项。网络、限流、超时和格式错误会在当前 API 重试。用途选择和链顺序自动保存，跟随的项目从下一次任务开始使用。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ListView x:Name="DefaultTranslationChainList" DisplayMemberPath="Name" SelectionMode="Single" MaxHeight="160" SelectionChanged="TranslationChain_SelectionChanged" AutomationProperties.Name="全局默认翻译 API 顺序，第一项优先" />
                <TextBlock x:Name="DefaultTranslationChainEmptyText" Text="尚未配置默认翻译 API，请从下方添加。" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Button x:Name="MoveDefaultTranslationUpButton" Content="上移" Click="MoveTranslationUp_Click" />
                  <Button x:Name="MoveDefaultTranslationDownButton" Content="下移" Click="MoveTranslationDown_Click" />
                  <Button x:Name="RemoveDefaultTranslationApiButton" Content="从链中移除" Click="RemoveTranslationApi_Click" />
                </StackPanel>
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <ComboBox x:Name="DefaultTranslationCandidateBox" Header="添加默认翻译 API" DisplayMemberPath="Name" PlaceholderText="选择已保存的 API 配置" HorizontalAlignment="Stretch" SelectionChanged="TranslationChain_SelectionChanged" />
                  <Button x:Name="AddDefaultTranslationApiButton" Grid.Column="1" Content="添加到链末尾" VerticalAlignment="Bottom" Click="AddTranslationApi_Click" />
                </Grid>
              </StackPanel>
            </Expander>
            <Expander Header="默认智能适配预算" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="12">
                <NumberBox x:Name="DefaultTokenBudgetBox" Header="每次适配 Token 预算" Value="1000000" Minimum="1000" Maximum="20000000" SpinButtonPlacementMode="Inline" />
                <NumberBox x:Name="DefaultMaximumTurnsBox" Header="每次最多模型轮数" Value="60" Minimum="1" Maximum="400" SpinButtonPlacementMode="Inline" />
                <TextBlock Text="Token 默认 1M，最多 20M；轮数默认 60，最多 400。每次开始或继续适配时使用，任一上限达到后暂停并保存进度。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="SaveGlobalLimitsButton" Content="保存默认预算与轮数" Click="SaveGlobalLimits_Click" HorizontalAlignment="Left" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <Grid x:Name="CatalogView" Grid.Row="1" Visibility="Collapsed" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Spacing="6">
          <TextBlock Text="全局引擎库" FontSize="26" FontWeight="SemiBold" />
          <TextBlock Text="管理所有项目共用的引擎、资源模板与经验。启停仅影响新的识别候选，已有项目固定的版本仍可使用。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <InfoBar x:Name="CatalogInfo" Grid.Row="1" IsOpen="False" IsClosable="True" Severity="Informational" />
        <Grid x:Name="CatalogLayout" Grid.Row="2" ColumnSpacing="16" SizeChanged="CatalogLayout_SizeChanged">
          <Grid.ColumnDefinitions><ColumnDefinition x:Name="CatalogListColumn" Width="*" /><ColumnDefinition x:Name="CatalogDetailColumn" Width="1.2*" /></Grid.ColumnDefinitions>
          <Grid x:Name="CatalogListPane" RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <TextBox x:Name="CatalogSearchBox" PlaceholderText="搜索引擎、模板或兼容游戏" TextChanged="CatalogSearch_TextChanged" AutomationProperties.Name="搜索引擎、模板或兼容游戏" />
            <Grid x:Name="CatalogFiltersGrid" Grid.Row="1" ColumnSpacing="8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <ComboBox x:Name="CatalogSourceFilter" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="CatalogFilter_Changed" AutomationProperties.Name="引擎来源">
                <ComboBoxItem Content="全部来源" Tag="all" /><ComboBoxItem Content="内置" Tag="builtin" /><ComboBoxItem Content="外置扩展" Tag="external" /><ComboBoxItem Content="仅历史记录" Tag="history" />
              </ComboBox>
              <ComboBox x:Name="CatalogEnabledFilter" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="CatalogFilter_Changed" AutomationProperties.Name="引擎启用状态">
                <ComboBoxItem Content="全部状态" Tag="all" /><ComboBoxItem Content="已启用" Tag="enabled" /><ComboBoxItem Content="已停用" Tag="disabled" />
              </ComboBox>
              <ComboBox x:Name="CatalogSortBox" Grid.Column="2" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="CatalogFilter_Changed" AutomationProperties.Name="引擎排序">
                <ComboBoxItem Content="按名称" Tag="name" /><ComboBoxItem Content="最近发布" Tag="recent" /><ComboBoxItem Content="兼容游戏数" Tag="games" />
              </ComboBox>
            </Grid>
            <Grid Grid.Row="2" ColumnSpacing="8" RowSpacing="6">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <TextBlock x:Name="CatalogCountText" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
              <Button x:Name="CatalogRefreshButton" Grid.Column="1" Content="刷新" Click="RefreshCatalog_Click" Padding="10,5" />
              <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                <ToggleButton x:Name="CatalogMultiSelectButton" Content="多选" Checked="CatalogMultiSelect_Changed" Unchecked="CatalogMultiSelect_Changed" Padding="10,5" />
                <Button x:Name="CatalogEnableButton" Content="启用所选" Click="CatalogEnable_Click" IsEnabled="False" Padding="10,5" />
                <Button x:Name="CatalogDisableButton" Content="停用所选" Click="CatalogDisable_Click" IsEnabled="False" Padding="10,5" />
              </StackPanel>
            </Grid>
            <Grid Grid.Row="3">
              <ListView x:Name="CatalogFamiliesList" SelectionMode="Extended" SelectionChanged="CatalogFamilies_SelectionChanged" IsItemClickEnabled="True" ItemClick="CatalogFamily_ItemClick" HorizontalContentAlignment="Stretch" AutomationProperties.Name="引擎与资源模板，按住 Ctrl 或 Shift 可多选">
                <ListView.ItemTemplate><DataTemplate>
                  <StackPanel Padding="0,8" Spacing="3">
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Name}" />
                      <TextBlock Grid.Column="1" Text="{Binding EnabledLabel}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <TextBlock Text="{Binding Id}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  </StackPanel>
                </DataTemplate></ListView.ItemTemplate>
              </ListView>
              <StackPanel x:Name="CatalogLoadingPanel" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <ProgressRing x:Name="CatalogLoadingRing" Width="28" Height="28" IsActive="False" /><TextBlock Text="正在读取引擎库…" AutomationProperties.LiveSetting="Polite" />
              </StackPanel>
              <TextBlock x:Name="CatalogEmptyText" Text="暂无引擎记录。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="8,20" Visibility="Collapsed" />
            </Grid>
          </Grid>
          <Grid x:Name="CatalogDetailPane" Grid.Column="1" RowSpacing="12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0" Padding="16,0,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Button x:Name="CatalogBackButton" Content="← 返回引擎列表" Click="CatalogBack_Click" Visibility="Collapsed" />
            <StackPanel Grid.Row="1" Spacing="4">
              <TextBlock x:Name="CatalogDetailTitle" Text="选择引擎或资源模板" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock x:Name="CatalogDetailSubtitle" Text="查看版本、兼容游戏与相关经验。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
            </StackPanel>
            <TabView x:Name="CatalogDetailTabs" Grid.Row="2" IsAddTabButtonVisible="False" CanReorderTabs="False" CanDragTabs="False" TabWidthMode="SizeToContent" Visibility="Collapsed">
              <TabViewItem Header="概览" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Spacing="16" Padding="0,16,8,12">
                    <TextBlock x:Name="CatalogOverviewText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock Text="样本回填或结构校验通过，不代表游戏内运行已验证。兼容记录保留各版本的验证结果。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="启停影响后续新识别和适配的候选选择。项目已有的固定版本和回滚记录会保留。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  </StackPanel>
                </ScrollViewer>
              </TabViewItem>
              <TabViewItem Header="版本" IsClosable="False">
                <Grid RowSpacing="8" Padding="0,12,0,0">
                  <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <ListView x:Name="CatalogVersionsList" SelectionMode="Single" SelectionChanged="CatalogVersion_SelectionChanged" IsItemClickEnabled="True" ItemClick="CatalogVersion_ItemClick" HorizontalContentAlignment="Stretch" AutomationProperties.Name="所选引擎的版本">
                    <ListView.ItemTemplate><DataTemplate><StackPanel Padding="0,8" Spacing="4">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel></DataTemplate></ListView.ItemTemplate>
                  </ListView>
                  <TextBlock x:Name="CatalogVersionReferenceText" Grid.Row="1" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                  <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Padding="0,0,0,8">
                    <Button x:Name="CatalogOpenVersionButton" Content="打开所在文件夹" Click="CatalogOpenVersion_Click" IsEnabled="False" />
                    <Button x:Name="CatalogVerifyVersionButton" Content="验证发布包…" Click="CatalogVerifyVersion_Click" IsEnabled="False" ToolTipService.ToolTip="选择一个已提取且空闲的同引擎项目，验证这份发布包的资源处理能力。此操作不调用模型，游戏内效果需另行验证。" />
                    <Button x:Name="CatalogDeleteVersionButton" Content="删除版本…" Click="CatalogDeleteVersion_Click" IsEnabled="False" />
                  </StackPanel>
                </Grid>
              </TabViewItem>
              <TabViewItem Header="兼容游戏" IsClosable="False">
                <Grid RowSpacing="8" Padding="0,12,0,0">
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                  <TextBox x:Name="CatalogGameSearchBox" PlaceholderText="筛选游戏名称或版本" TextChanged="CatalogGameSearch_TextChanged" AutomationProperties.Name="筛选所选引擎的兼容游戏" />
                  <TextBlock x:Name="CatalogGameCountText" Grid.Row="1" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                  <ListView x:Name="CatalogGamesList" Grid.Row="2" SelectionMode="None" HorizontalContentAlignment="Stretch" AutomationProperties.Name="引擎兼容游戏">
                    <ListView.ItemTemplate><DataTemplate><StackPanel Padding="0,8" Spacing="4">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Description}" FontSize="12" MaxLines="3" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                      <TextBlock Text="{Binding Validation}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel></DataTemplate></ListView.ItemTemplate>
                  </ListView>
                </Grid>
              </TabViewItem>
              <TabViewItem Header="相关经验" IsClosable="False">
                <Grid RowSpacing="8" Padding="0,12,0,0">
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                  <TextBlock x:Name="CatalogKnowledgeCountText" Text="暂无相关经验。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  <ListView x:Name="EngineKnowledgeList" Grid.Row="1" MaxHeight="180" SelectionMode="Single" SelectionChanged="EngineKnowledge_SelectionChanged" HorizontalContentAlignment="Stretch" AutomationProperties.Name="相关全局引擎经验">
                    <ListView.ItemTemplate><DataTemplate><StackPanel Padding="0,6" Spacing="3">
                      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" /><TextBlock Text="{Binding StatusLabel}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel></DataTemplate></ListView.ItemTemplate>
                  </ListView>
                  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="12" Padding="0,0,8,12">
                      <CheckBox x:Name="CatalogKnowledgeEnabledBox" Content="用于后续智能识别与适配" Click="CatalogKnowledgeEnabled_Click" IsEnabled="False" />
                      <ProgressBar x:Name="CatalogKnowledgeProgress" IsIndeterminate="True" Visibility="Collapsed" />
                      <TextBlock x:Name="CatalogKnowledgeDetailText" Text="选择经验以查看适用条件与分析指引。" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </StackPanel>
                  </ScrollViewer>
                </Grid>
              </TabViewItem>
            </TabView>
          </Grid>
        </Grid>
      </Grid>
      <Grid x:Name="ApplicationSettingsView" Grid.Row="1" Visibility="Collapsed" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Spacing="6">
          <TextBlock Text="程序设置" FontSize="26" FontWeight="SemiBold" />
          <TextBlock Text="全局设置 · 数据保存位置与并行翻译数量应用于整个游戏库。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="20" Padding="0,20,8,12">
            <TextBox x:Name="DataDirectoryBox" Header="数据保存位置" IsReadOnly="True" TextWrapping="Wrap" />
            <Button x:Name="ChangeDataDirectoryButton" Content="更换保存位置" Click="ChangeDataDirectory_Click" HorizontalAlignment="Left" />
            <TextBlock Text="更换时可选择迁移现有数据或仅切换目录，完成后立即生效。原目录的数据会保留，运行中的任务会先暂停。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="此目录保存游戏项目、译文、校对、原文快照、安装记录及 API 配置。备份时先关闭程序，再复制整个目录；自动恢复游戏原文件还需保留游戏目录中的 .bak 备份。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Expander Header="备份与数据迁移" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="12">
                <TextBlock Text="“迁移并切换”复制并校验现有数据；首次迁移选择空目录，中断后可从原位置重新选择相同目标继续。“仅切换”直接打开所选目录已有的数据，空目录显示为空游戏库。" TextWrapping="Wrap"/>
                <TextBlock Text="原文快照和异常诊断可能包含游戏文本。已保存的 API 密钥受当前 Windows 用户保护，复制数据后仍需使用原用户；更换用户时请重新配置密钥。" TextWrapping="Wrap"/>
              </StackPanel>
            </Expander>
            <ProgressBar x:Name="DataDirectoryProgress" IsIndeterminate="True" Visibility="Collapsed" />
            <NumberBox x:Name="ConcurrentGamesBox" Header="同时翻译的游戏数量" Value="2" Minimum="1" Maximum="8" SpinButtonPlacementMode="Inline" Width="220" HorizontalAlignment="Left" />
            <TextBlock Text="并行翻译数量保存后在下次启动时生效。同一游戏同时执行一个任务；常规识别、智能适配和翻译分别调度，智能适配同时运行一个游戏，同一 API 的请求会排队。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button x:Name="SaveApplicationSettingsButton" Content="保存程序设置" Click="SaveApplicationSettings_Click" HorizontalAlignment="Left" />
            <InfoBar x:Name="ApplicationSettingsInfo" IsOpen="False" IsClosable="True" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <TextBlock Grid.Row="2" x:Name="FooterText" Text="数据保存在本机。关闭程序后，已提交的译文仍可复用。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontSize="12" />
    </Grid>
  </Grid>
</Window>
