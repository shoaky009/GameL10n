<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AssemblyName>AvgTranslator.VnTextPatch</AssemblyName>
    <RootNamespace>AvgTranslator.VnTextPatch</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../third_party/VNTextPatch/**/*.cs" LinkBase="VNTextPatch" />
    <None Include="../../third_party/VNTextPatch/LICENSE" Link="VNTextPatch.LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../third_party/VNTextPatch/NOTICE.md" Link="VNTextPatch.NOTICE.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
