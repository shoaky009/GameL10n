import { Button, ComboBox, LineEdit, ListView } from "std-widgets.slint";
import { App, Theme, Heading, Label, Caption, Divider } from "state.slint";
import { TokenChart } from "token-chart.slint";

export component ConsumptionMetrics inherits VerticalLayout {
    spacing: 12px;
    vertical-stretch: 1;
    HorizontalLayout {
        Heading { text: "消耗指标"; font-size: 26px; }
        Rectangle { horizontal-stretch: 1; }
        Button { text: "重置筛选"; clicked => {
            App.metrics-version-index = 0; App.metrics-model-index = 0; App.metrics-project-index = 0;
            App.metrics-task-index = 0; App.metrics-mode-index = 0; App.metrics-status-index = 0;
            App.metrics-date-range = 0; App.metrics-from = ""; App.metrics-through = "";
            App.metrics-offset = 0; App.action("metrics", "refresh");
        } }
        Button { text: App.metrics-loading ? "刷新中…" : "刷新"; enabled: !App.metrics-loading; clicked => { App.action("metrics", "refresh"); } }
    }
    HorizontalLayout { spacing: 8px;
        ComboBox { model: ["全部日期", "今天", "近 7 天", "近 30 天", "自定义日期"]; current-index <=> App.metrics-date-range; selected => { App.metrics-offset = 0; App.action("metrics", "refresh"); } }
        ComboBox { model: App.metrics-versions; current-index <=> App.metrics-version-index; selected => { App.metrics-offset = 0; App.action("metrics", "refresh"); } }
        ComboBox { model: App.metrics-models; min-width: 0px; current-index <=> App.metrics-model-index; selected => { App.metrics-offset = 0; App.action("metrics", "refresh"); } Tooltip { text: @markdown("\{App.metrics-models[App.metrics-model-index]}"); } }
        ComboBox { model: App.metrics-projects; current-index <=> App.metrics-project-index; selected => { App.metrics-offset = 0; App.action("metrics", "refresh"); } }
    }
    if App.metrics-date-range == 4: HorizontalLayout { spacing: 8px;
        Label { text: "开始日期"; vertical-alignment: center; }
        LineEdit { text <=> App.metrics-from; placeholder-text: "YYYY-MM-DD"; accepted => { App.metrics-offset = 0; App.action("metrics", "refresh"); } }
        Label { text: "结束日期"; vertical-alignment: center; }
        LineEdit { text <=> App.metrics-through; placeholder-text: "YYYY-MM-DD"; accepted => { App.metrics-offset = 0; App.action("metrics", "refresh"); } }
        Button { text: "应用日期"; clicked => { App.metrics-offset = 0; App.action("metrics", "refresh"); } }
    }
    HorizontalLayout { spacing: 8px;
        ComboBox { model: ["全部任务", "识别与适配", "智能适配", "修复适配", "扩展覆盖", "经验总结"]; current-index <=> App.metrics-task-index; selected => { App.metrics-offset = 0; App.action("metrics", "refresh"); } }
        ComboBox { model: ["全部执行方式", "新运行", "续接", "复用结果"]; current-index <=> App.metrics-mode-index; selected => { App.metrics-offset = 0; App.action("metrics", "refresh"); } }
        ComboBox { model: ["全部状态", "运行中", "完成", "失败", "取消", "等待继续", "中断", "不支持"]; current-index <=> App.metrics-status-index; selected => { App.metrics-offset = 0; App.action("metrics", "refresh"); } }
        Rectangle { horizontal-stretch: 1; }
    }
    if App.metrics-error != "": Label { text: App.metrics-error; color: Theme.error; }
    if App.metrics-error == "": VerticalLayout { spacing: 6px;
        Label { text: App.metrics-overview; font-weight: 600; }
        Label { text: App.metrics-tokens; }
        Label { text: App.metrics-timing; }
    }
    Divider {}
    HorizontalLayout { spacing: 8px;
        Button { text: "分组趋势"; checked: App.metrics-tab == 0; clicked => { App.metrics-tab = 0; App.metrics-offset = 0; App.action("metrics", "refresh"); } }
        Button { text: "执行记录"; checked: App.metrics-tab == 1; clicked => { App.metrics-tab = 1; App.metrics-offset = 0; App.action("metrics", "refresh"); } }
        Rectangle { horizontal-stretch: 1; }
    }
    if App.metrics-tab == 0: HorizontalLayout { spacing: 8px;
        Label { text: "分组"; vertical-alignment: center; }
        ComboBox { model: ["日期", "软件版本", "模型配置", "任务类型", "游戏项目", "执行方式", "状态"]; current-index <=> App.metrics-dimension; selected => { App.metrics-offset = 0; App.action("metrics", "refresh"); } }
        ComboBox { model: ["Token 用量", "未缓存输入 Token", "缓存命中率", "总耗时", "API 耗时", "等待耗时", "本地及其他耗时", "API 请求次数", "失败请求次数"]; current-index <=> App.metrics-measure; selected => { App.action("metrics", "refresh"); } }
        ComboBox { model: ["合计", "单次运行平均"]; current-index <=> App.metrics-aggregation; enabled: App.metrics-measure != 2; selected => { App.action("metrics", "refresh"); } }
    }
    if App.metrics-tab == 0 && App.metrics-total > 0: Caption { text: App.metrics-chart-title; }
    Rectangle { vertical-stretch: 1; min-height: App.metrics-tab == 0 && App.metrics-measure == 0 ? 162px : 130px;
        if App.metrics-total == 0 && App.metrics-error == "": Label { text: App.metrics-loading ? "正在读取指标…" : App.metrics-empty; x: 12px; y: 20px; width: parent.width - 24px; }
        if App.metrics-tab == 0 && App.metrics-total > 0 && App.metrics-measure == 0: TokenChart { points: App.token-points; segments: App.token-segments; ticks: App.token-ticks; known: App.token-chart-known; }
        if App.metrics-tab == 0 && App.metrics-total > 0 && App.metrics-measure != 0: ListView {
            for group in App.metric-groups: Rectangle { height: 82px;
                VerticalLayout { padding-top: 6px; padding-bottom: 10px; padding-right: 12px; spacing: 5px;
                    HorizontalLayout { spacing: 12px;
                        Label { text: group.label; font-weight: 600; wrap: no-wrap; overflow: elide; horizontal-stretch: 1; }
                        Label { text: group.value; color: Theme.accent; horizontal-stretch: 0; }
                    }
                    Rectangle { height: 8px; background: Theme.line;
                        Rectangle { x: 0px; y: 0px; width: parent.width * group.fraction; height: parent.height; background: Theme.accent; }
                    }
                    Caption { text: group.detail; wrap: no-wrap; overflow: elide; }
                }
            }
        }
        if App.metrics-tab == 1 && App.metrics-total > 0: ListView {
            for record in App.consumption-rows: Rectangle { height: root.width < 1000px ? 128px : 110px; clip: true;
                VerticalLayout { padding-top: 8px; padding-bottom: 10px; padding-right: 12px; spacing: 5px; alignment: start;
                    Label { text: record.identity; font-weight: 600; wrap: no-wrap; overflow: elide; }
                    Caption { text: record.configuration; wrap: no-wrap; overflow: elide; Tooltip { text: @markdown("\{record.configuration}"); } }
                    Caption { text: record.counters; }
                    Divider {}
                }
            }
        }
    }
    HorizontalLayout { spacing: 8px;
        Caption { text: App.metrics-total == 0 ? "" : (App.metrics-offset + 1) + "–" + min(App.metrics-offset + 20, App.metrics-total) + " / " + App.metrics-total; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        Button { text: "上一页"; enabled: App.metrics-offset > 0; clicked => { App.metrics-offset = max(0, App.metrics-offset - 20); App.action("metrics", "refresh"); } }
        Button { text: "下一页"; enabled: App.metrics-offset + 20 < App.metrics-total; clicked => { App.metrics-offset += 20; App.action("metrics", "refresh"); } }
    }
    Caption { text: App.metrics-coverage; }
    Caption { text: "缓存属于输入；≥ 表示仅统计已知用量。未缓存输入与命中率仅使用有效缓存计数。"; }
    refresh := Timer { interval: 30s; running: App.page == 5; triggered => { if !App.metrics-loading { App.action("metrics", "auto"); } } }
}
