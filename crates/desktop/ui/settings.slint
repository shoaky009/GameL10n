import { Button, CheckBox, LineEdit, TextEdit, ComboBox, SpinBox, ScrollView, ListView, ProgressIndicator } from "std-widgets.slint";
import { App, Theme, Label, Caption, TokenCaption, Heading, Divider, ReportText } from "state.slint";

export component ApiTestControls inherits VerticalLayout {
    spacing: 8px;
    private property <bool> available: !App.api-testing && (App.modal == "api" ? App.api-endpoint != "" && App.api-model != "" : App.api-id != "");
    HorizontalLayout { spacing: 8px;
        Button { text: "测试翻译"; enabled: root.available; clicked => { App.action("api-test", "translation"); } }
        Button { text: "测试分析"; enabled: root.available; clicked => { App.action("api-test", "analysis"); } }
        if App.api-testing: Button { text: "取消测试"; clicked => { App.action("api-test-cancel", ""); } }
        Rectangle { horizontal-stretch: 1; }
    }
    if App.api-testing: VerticalLayout { spacing: 5px;
        Caption { text: "正在测试，最多等待 45 秒…"; }
        ProgressIndicator { indeterminate: true; height: 3px; }
    }
    if App.api-test-result != "": ScrollView {
        height: min(100px, test-result.preferred-height); horizontal-scrollbar-policy: always-off;
        content-width: self.visible-width; content-height: max(self.visible-height, test-result.height);
        test-result := ReportText { width: parent.visible-width - 12px; text: App.api-test-result; color: App.api-test-failed ? Theme.error : Theme.ink; }
    }
    Caption { text: "测试发送一条简短请求，按接口规则计费；分析测试检查工具调用。"; }
}

component ApiSelection inherits VerticalLayout {
    spacing: 10px;
    Label { text: "智能识别与适配 API"; }
    ComboBox { model: App.api-names; current-index <=> App.analysis-index; selected => { App.action("analysis-api", ""); } }
    Divider {}
    Label { text: "文本翻译 API 链"; font-weight: 600; }
    Caption { text: "从上到下尝试，仅模型拒绝处理时切换下一项。网络、限流和格式错误在当前 API 重试。"; }
    ListView { height: min(150px, max(40px, App.chain.length * 44px));
        for item[index] in App.chain: Rectangle { height: 44px; background: App.chain-index == index ? Theme.tint : Theme.surface;
            HorizontalLayout { padding: 8px; Label { text: (index + 1) + ". " + item.name; } Caption { text: item.detail; } }
            TouchArea { clicked => { App.chain-index = index; } }
        }
    }
    if App.chain.length == 0: Caption { text: "尚未配置翻译 API。"; }
    HorizontalLayout {
        Button { text: "上移"; enabled: App.chain-index > 0; clicked => { App.action("chain-up", ""); } }
        Button { text: "下移"; enabled: App.chain-index >= 0 && App.chain-index < App.chain.length - 1; clicked => { App.action("chain-down", ""); } }
        Button { text: "从链中移除"; enabled: App.chain-index >= 0; clicked => { App.action("chain-remove", ""); } }
        Rectangle { horizontal-stretch: 1; }
    }
    HorizontalLayout {
        ComboBox { model: App.api-names; current-index <=> App.candidate-api-index; horizontal-stretch: 1; }
        Button { text: "添加到链末尾"; enabled: App.candidate-api-index >= 0; clicked => { App.action("chain-add", ""); } }
    }
    Divider {} Label { text: "智能适配预算"; font-weight: 600; }
    HorizontalLayout {
        VerticalLayout { spacing: 5px;
            Caption { text: "每次适配 Token 预算（最多 20M）"; }
            HorizontalLayout { spacing: 10px;
                LineEdit { text <=> App.budget; input-type: number; horizontal-stretch: 1; }
                TokenCaption { value: App.budget-preview; min-width: 100px; vertical-alignment: center; }
            }
        }
        VerticalLayout { spacing: 5px; Caption { text: "每次最多模型轮数"; } SpinBox { value <=> App.turns; minimum: 1; maximum: 400; } }
    }
}

export component WorkflowControls inherits VerticalLayout {
    spacing: 8px;
    Caption { text: "完成目标"; }
    ComboBox {
        model: App.workflow-has-custom
            ? ["仅试译并验证", "验证后生成全量补丁", "验证后生成并安装全量补丁", "使用自定义流程"]
            : ["仅试译并验证", "验证后生成全量补丁", "验证后生成并安装全量补丁"];
        current-index <=> App.workflow-finish;
    }
    if App.workflow-finish != 3: CheckBox {
        text: "使用已有提取文本";
        checked <=> App.workflow-use-existing-text;
        enabled: App.workflow-can-use-existing-text || self.checked;
    }
    if App.workflow-finish != 3 && App.workflow-use-existing-text && !App.workflow-can-use-existing-text: Caption {
        text: "已有提取文本不可用，请取消勾选后运行。";
    }
    if App.workflow-finish == 1: Caption { text: "游戏中会保留试译补丁，全量补丁可稍后安装。"; }
}

export component ProjectSettings inherits ScrollView {
    VerticalLayout { padding: 16px; spacing: 16px;
        Heading { text: "游戏启动"; }
        Caption { text: App.launch-summary; }
        HorizontalLayout { Button { text: "配置启动入口…"; clicked => { App.action("launch-settings", ""); } } Rectangle { horizontal-stretch: 1; } }
        Divider {}
        Heading { text: "自动汉化"; }
        HorizontalLayout { spacing: 8px;
            Button { text: "配置自动汉化…"; enabled: !App.busy; clicked => { App.action("workflow-settings", ""); } }
            Button { text: "运行检查…"; enabled: !App.busy; clicked => { App.action("game-check-dialog", ""); } }
            Rectangle { horizontal-stretch: 1; }
        }
        Divider {}
        HorizontalLayout { Button { text: "管理模型配置"; clicked => { App.action("navigate", "apis"); } } Rectangle { horizontal-stretch: 1; } }
        Caption { text: "未单独配置的项自动使用全局设置，修改后仅对当前项目生效。"; }
        ApiSelection {}
        Divider {} Heading { text: "翻译语言与术语"; }
        Caption { text: "目标语言"; } LineEdit { text <=> App.language; }
        Caption { text: "翻译风格"; } TextEdit { text <=> App.style; height: 70px; }
        Caption { text: "术语表（每行：原文=译文）"; } TextEdit { text <=> App.terminology; height: 120px; }
        HorizontalLayout { spacing: 16px;
            Label { text: "每批文本数"; horizontal-stretch: 0; vertical-alignment: center; }
            SpinBox { value <=> App.batch-size; minimum: 1; maximum: 80; width: 100px; horizontal-stretch: 0; }
            Rectangle { horizontal-stretch: 1; }
        }
        HorizontalLayout { Button { text: "保存项目设置"; primary: true; clicked => { App.action("save-project-settings", ""); } } Rectangle { horizontal-stretch: 1; } }
        Divider {}
        HorizontalLayout { spacing: 12px;
            Button { text: "清理项目文件…"; enabled: !App.busy; clicked => { App.action("cleanup-dialog", ""); } }
            Caption { text: App.source-materials-cleared ? "原文工作资源已清理，项目、译文和当前补丁已保留。" : "按类别清理适配工作文件、原文资源副本、历史补丁和日志。"; horizontal-stretch: 1; }
        }
    }
}

export component GlobalApis inherits VerticalLayout {
    spacing: 16px; Heading { text: "模型配置"; font-size: 26px; }
    ScrollView { VerticalLayout { spacing: 16px;
        HorizontalLayout { Button { text: "新增配置"; primary: true; enabled: !App.api-testing; clicked => { App.action("api-add", ""); } } Button { text: "编辑所选配置"; enabled: App.api-id != "" && !App.api-testing; clicked => { App.action("api-edit", App.api-id); } } Button { text: "删除所选配置"; enabled: App.api-id != "" && !App.api-testing; clicked => { App.action("api-delete-dialog", App.api-id); } } Rectangle { horizontal-stretch: 1; } }
        ListView { height: min(210px, max(50px, App.apis.length * 65px));
            for api in App.apis: Rectangle { height: 65px; background: App.api-id == api.id ? Theme.tint : Theme.surface;
                VerticalLayout { padding: 10px; Label { text: api.name; font-weight: 600; } Caption { text: api.detail; } }
                TouchArea { enabled: !App.api-testing; clicked => { App.api-id = api.id; App.api-test-result = ""; } }
            }
        }
        if App.apis.length == 0: Caption { text: "尚未添加模型配置。第一份配置同时用作分析和翻译的全局默认。"; }
        ApiTestControls {}
        ApiSelection {}
        HorizontalLayout { Button { text: "保存默认预算与轮数"; primary: true; clicked => { App.action("save-defaults", ""); } } Rectangle { horizontal-stretch: 1; } }
        Caption { text: "项目未单独配置的项自动使用这里的全局设置。修改后用于后续任务，无需重启。"; }
    } }
}
