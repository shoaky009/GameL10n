import { LineEdit, ScrollView } from "std-widgets.slint";
import { App, Card, Heading, SectionHeading, Label, Caption, Divider, ActionButton, CopyButton, ClipboardBuffer } from "state.slint";

export component About inherits ScrollView {
    vertical-stretch: 1;
    horizontal-scrollbar-policy: always-off;
    content-width: self.visible-width;
    content-height: about-content.preferred-height;
    clipboard := ClipboardBuffer {}
    about-content := VerticalLayout { x: 0px; y: 0px; width: min(root.visible-width, 820px); height: self.preferred-height; padding-right: 12px; spacing: 16px; alignment: start;
        Heading { text: "关于 GameL10n"; font-size: 24px; }
        Label { text: "面向游戏文本汉化的 Windows 桌面工具，提供资源识别、文本提取、AI 翻译、译文校对和汉化补丁生成。"; }
        Card {
            VerticalLayout { padding: 16px; spacing: 10px;
                GridLayout { spacing: 10px;
                    Row {
                        Label { text: "版本号"; vertical-alignment: center; }
                        LineEdit { text: App.software-version; read-only: true; }
                        CopyButton { label: "复制版本号"; value: App.software-version; copy(value) => { clipboard.copy-text(value); } }
                    }
                    Row {
                        Label { text: "构建 Git hash"; vertical-alignment: center; }
                        LineEdit { text: App.build-git-hash == "unknown" ? "未知" : App.build-git-hash; read-only: true; }
                        CopyButton { label: "复制 Git hash"; value: App.build-git-hash == "unknown" ? "" : App.build-git-hash; copy(value) => { clipboard.copy-text(value); } }
                    }
                }
            }
        }
        Card {
            VerticalLayout { padding: 16px; spacing: 12px;
                SectionHeading { text: "项目与支持"; }
                HorizontalLayout { spacing: 8px;
                    Label { text: "GitHub 仓库"; vertical-alignment: center; }
                    LineEdit { text: App.repository-url; read-only: true; horizontal-stretch: 1; }
                    CopyButton { label: "复制仓库地址"; value: App.repository-url; copy(value) => { clipboard.copy-text(value); } }
                    ActionButton { text: "打开仓库"; icon: "external-link"; clicked => { App.action("project-link", "repository"); } }
                }
                HorizontalLayout { spacing: 8px;
                    ActionButton { text: "发布与更新"; icon: "external-link"; compact: true; clicked => { App.action("project-link", "releases"); } }
                    ActionButton { text: "问题反馈"; icon: "external-link"; compact: true; clicked => { App.action("project-link", "issues"); } }
                    ActionButton { text: "使用文档"; icon: "book"; compact: true; clicked => { App.action("project-link", "documentation"); } }
                    ActionButton { text: "更新日志"; icon: "list"; compact: true; clicked => { App.action("project-link", "changelog"); } }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }
        Card {
            VerticalLayout { padding: 16px; spacing: 10px;
                SectionHeading { text: "开源许可"; }
                Label { text: "主程序采用 " + App.software-license + " 许可证。"; }
                Caption { text: "独立组件和第三方材料保留各自的许可与版权声明。"; }
                HorizontalLayout { spacing: 8px;
                    ActionButton { text: "查看许可证"; icon: "external-link"; compact: true; clicked => { App.action("project-link", "license"); } }
                    ActionButton { text: "第三方声明"; icon: "external-link"; compact: true; clicked => { App.action("project-link", "third-party"); } }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }
    }
}
