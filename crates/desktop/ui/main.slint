import { Button, LineEdit, ComboBox, ScrollView, ListView, Palette } from "std-widgets.slint";

export struct ProjectRow { id: string, name: string, path: string, status: string, running: bool }
export struct TextRow { id: string, resource: string, source: string }

export component MainWindow inherits Window {
    title: "GameL10n";
    preferred-width: 1160px;
    preferred-height: 780px;
    min-width: 880px;
    min-height: 620px;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 14px;

    in property <[ProjectRow]> projects;
    in property <[TextRow]> texts;
    in property <[string]> formats;
    in property <string> data-directory;
    in-out property <string> selected-id;
    in-out property <string> selected-name;
    in-out property <string> selected-path;
    in-out property <string> project-query;
    in-out property <string> text-query;
    in-out property <string> status: "正在加载项目列表。";
    in-out property <string> log-text;
    in-out property <bool> busy;
    in-out property <int> page-offset;
    in-out property <int> total-texts;
    in-out property <int> shown-texts;
    in-out property <bool> loading;
    in-out property <bool> app-ready;
    callback add-project(string);
    callback select-project(string);
    callback search-projects(string);
    callback extract(string, string);
    callback cancel-task(string);
    callback query-texts(string, string, int);
    callback open-project-folder(string);

    property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    property <color> surface: root.dark ? #151a21 : #ffffff;
    property <color> sidebar: root.dark ? #1a222d : #f1f6fc;
    property <color> tint: root.dark ? #253c55 : #e4effc;
    property <color> accent: root.dark ? #89bcfa : #255f9e;
    property <color> ink: root.dark ? #e2e8f0 : #202d3c;
    property <color> muted: root.dark ? #a7b6c8 : #5c6c7f;
    property <color> line: root.dark ? #334050 : #dce4ee;
    background: root.surface;

    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: 264px;
            background: root.sidebar;
            VerticalLayout {
                padding: 20px;
                spacing: 16px;
                Text { text: "GameL10n"; color: root.ink; font-size: 22px; font-weight: 600; }
                Text { text: "游戏项目"; color: root.muted; }
                LineEdit {
                    placeholder-text: "搜索名称或路径";
                    text <=> root.project-query;
                    edited => { root.search-projects(self.text); }
                }
                ListView {
                    vertical-stretch: 1;
                    for project in root.projects: Rectangle {
                        height: 76px;
                        border-radius: 6px;
                        background: project.id == root.selected-id ? root.tint : (hit.has-hover ? root.tint.transparentize(0.45) : transparent);
                        VerticalLayout {
                            padding: 10px;
                            spacing: 4px;
                            Text { text: project.name; color: root.ink; font-weight: project.id == root.selected-id ? 600 : 400; overflow: elide; }
                            Text { text: project.status; color: project.running ? root.accent : root.muted; font-size: 12px; overflow: elide; }
                        }
                        hit := TouchArea { clicked => { root.select-project(project.id); } }
                    }
                }
                Text { text: "添加游戏目录"; color: root.muted; font-size: 12px; }
                path-input := LineEdit { placeholder-text: "粘贴游戏文件夹路径"; }
                Button {
                    text: "添加项目";
                    enabled: root.app-ready && path-input.text != "";
                    clicked => { root.add-project(path-input.text); }
                }
                Text { text: "数据位置"; color: root.muted; font-size: 12px; }
                Text { text: root.data-directory; color: root.muted; font-size: 11px; wrap: word-wrap; }
            }
        }
        Rectangle { width: 1px; background: root.line; }
        VerticalLayout {
            padding: 24px;
            spacing: 16px;
            HorizontalLayout {
                VerticalLayout {
                    spacing: 5px;
                    Text { text: root.selected-id == "" ? "选择或添加游戏项目" : root.selected-name; color: root.ink; font-size: 24px; font-weight: 600; overflow: elide; }
                    Text { text: root.selected-path; color: root.muted; font-size: 12px; overflow: elide; }
                }
                Button { text: "项目文件夹"; enabled: root.selected-id != ""; clicked => { root.open-project-folder(root.selected-id); } }
            }
            Rectangle { height: 1px; background: root.line; }
            if root.selected-id == "": VerticalLayout {
                vertical-stretch: 1;
                alignment: center;
                spacing: 12px;
                Text { text: "从一个游戏目录开始"; color: root.ink; font-size: 20px; }
                Text { text: "添加项目后，选择脚本格式提取文本。"; color: root.muted; }
                Text { text: "打开项目会读取已保存的结果，提取操作由你发起。"; color: root.muted; }
                Text { text: root.status; color: root.muted; wrap: word-wrap; }
            }
            if root.selected-id != "": VerticalLayout {
                vertical-stretch: 1;
                spacing: 14px;
                HorizontalLayout {
                    Text { text: "脚本格式"; color: root.ink; vertical-alignment: center; }
                    format-select := ComboBox { model: root.formats; current-index: 18; enabled: !root.busy; min-width: 170px; }
                    Button { text: "提取脚本文本"; enabled: !root.busy && !root.loading; clicked => { root.extract(root.selected-id, format-select.current-value); } }
                    Button { text: "停止"; enabled: root.busy; clicked => { root.cancel-task(root.selected-id); } }
                    Rectangle { horizontal-stretch: 1; }
                }
                Text { text: root.status; color: root.busy || root.loading ? root.accent : root.muted; wrap: word-wrap; }
                LineEdit {
                    placeholder-text: "搜索原文或资源文件";
                    text <=> root.text-query;
                    enabled: !root.loading;
                    edited => { root.query-texts(root.selected-id, self.text, 0); }
                }
                Rectangle {
                    height: 32px;
                    background: root.sidebar;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        Text { text: "原文"; color: root.muted; vertical-alignment: center; }
                        Text { text: "资源位置"; color: root.muted; width: 225px; vertical-alignment: center; }
                    }
                }
                ListView {
                    vertical-stretch: 1;
                    for row in root.texts: Rectangle {
                        height: max(64px, source-label.preferred-height + 24px);
                        HorizontalLayout {
                            padding: 12px;
                            spacing: 20px;
                            source-label := Text { text: row.source; color: root.ink; wrap: word-wrap; }
                            Text { text: row.resource; color: root.muted; width: 225px; font-size: 12px; wrap: word-wrap; }
                        }
                        Rectangle { y: parent.height - 1px; height: 1px; background: root.line; }
                    }
                }
                HorizontalLayout {
                    Text { text: root.total-texts == 0 ? "暂无提取文本" : "共 " + root.total-texts + " 条 · 当前 " + (root.page-offset + 1) + "–" + (root.page-offset + root.shown-texts); color: root.muted; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "上一页"; enabled: root.page-offset > 0 && !root.loading; clicked => { root.query-texts(root.selected-id, root.text-query, max(0, root.page-offset - 100)); } }
                    Button { text: "下一页"; enabled: root.page-offset + root.shown-texts < root.total-texts && !root.loading; clicked => { root.query-texts(root.selected-id, root.text-query, root.page-offset + 100); } }
                }
            }
            Rectangle { height: 1px; background: root.line; }
            Text { text: "任务日志"; color: root.muted; font-size: 12px; }
            logs := ScrollView {
                height: 112px;
                content-y: min(0px, self.height - log-content.height);
                log-content := Text { text: root.log-text; color: root.muted; font-size: 12px; wrap: word-wrap; }
            }
        }
    }
}
