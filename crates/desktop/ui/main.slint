import { Button, LineEdit, CheckBox, SpinBox, ScrollView, ListView } from "std-widgets.slint";
import { App, Theme, Label, Caption, Heading, SectionHeading, ReportText, Divider, ProjectRow, TextRow, NamedRow, EngineRow, TermRow, TokenDisplay, CleanupRow, NavigationButton, Link } from "state.slint";
import { ProjectSettings, GlobalApis } from "settings.slint";
import { Workbench } from "workbench.slint";
import { Recognition, PatchPage, TaskFeedback } from "project.slint";
import { EngineLibrary } from "catalog.slint";
import { DialogLayer } from "dialogs.slint";
import { ConsumptionMetrics } from "metrics.slint";
import { About } from "about.slint";
export { App, ProjectRow, TextRow, NamedRow, EngineRow, TermRow, TokenDisplay, CleanupRow, MetricGroupRow, ConsumptionRow, TokenPoint, TokenSegment, MetricTick } from "state.slint";

export component MainWindow inherits Window {
    title: "GameL10n"; preferred-width: 1420px; preferred-height: 900px; min-width: 1120px; min-height: 720px;
    icon: @image-url("../assets/GameL10n.png");
    default-font-family: "Microsoft YaHei UI"; default-font-size: 14px; background: Theme.background;
    HorizontalLayout { padding: 16px; spacing: 20px;
        VerticalLayout { width: 220px; spacing: 8px;
            HorizontalLayout { Heading { text: "游戏项目"; font-size: 18px; } Rectangle { horizontal-stretch: 1; } }
            Button { text: "添加游戏"; enabled: App.ready && !App.adding-game; clicked => { App.action("browse", ""); } }
            HorizontalLayout { Button { text: App.multi-projects ? "取消" : "多选"; clicked => { App.action("project-selection", App.multi-projects ? "cancel" : "start"); } } Button { text: "移除"; enabled: App.project-id != "" || App.selected-projects > 0; clicked => { App.action("remove-dialog", ""); } } }
            LineEdit { text <=> App.project-query; placeholder-text: "搜索名称或路径"; edited => { App.action("projects", ""); } }
            ListView { vertical-stretch: 1; content-y <=> App.project-scroll-y;
                for project in App.projects: Rectangle { height: App.project-row-height; clip: true; background: App.page == 0 && project.id == App.project-id ? Theme.tint : project-hit.has-hover ? Theme.hover : transparent; border-width: project-key.has-focus ? 1px : 0px; border-color: Theme.accent; border-radius: 4px;
                    HorizontalLayout { padding: 8px; spacing: 6px;
                        if App.multi-projects: CheckBox { checked: project.selected; toggled => { App.action("toggle-project", project.id); } }
                        Rectangle { horizontal-stretch: 1;
                            VerticalLayout { spacing: 4px; alignment: start;
                                Label { text: App.concise-text(project.name); height: 22px; color: Theme.title; font-weight: 600; overflow: elide; wrap: no-wrap; }
                                Caption { text: App.concise-text(project.status); height: 20px; line-height-factor: 1; color: project.running ? Theme.accent : Theme.secondary; overflow: elide; wrap: no-wrap; }
                                Caption { text: App.concise-text(project.path); height: 18px; font-size: 12px; line-height-factor: 1; overflow: elide; wrap: no-wrap; }
                            }
                            project-key := FocusScope { key-pressed(event) => { if event.text == Key.Return || event.text == " " { App.action("project", project.id); return accept; } return reject; } }
                            project-hit := TouchArea { mouse-cursor: pointer; clicked => { project-key.focus(); App.action("project", project.id); } }
                        }
                    }
                }
            }
            Divider {}
            NavigationButton { text: "模型配置"; selected: App.page == 1; clicked => { App.action("navigate", "apis"); } }
            NavigationButton { text: "全局引擎库"; selected: App.page == 2; clicked => { App.action("navigate", "catalog"); } }
            NavigationButton { text: "消耗指标"; selected: App.page == 5; clicked => { App.action("navigate", "metrics"); } }
            NavigationButton { text: "程序设置"; selected: App.page == 3; clicked => { App.action("navigate", "settings"); } }
            NavigationButton { text: "关于"; selected: App.page == 4; clicked => { App.action("navigate", "about"); } }
        }
        VerticalLayout { spacing: 12px;
            if App.page == 0: project-area := ScrollView {
                vertical-stretch: 1;
                horizontal-scrollbar-policy: always-off;
                content-width: self.visible-width;
                content-height: max(self.visible-height, project-content.min-height);
                private property <string> project-key: App.project-id;
                private property <int> tab-key: App.tab;
                changed project-key => { self.content-y = 0px; }
                changed tab-key => { self.content-y = 0px; }
                project-content := VerticalLayout { width: project-area.visible-width; height: project-area.content-height; spacing: 12px;
                if App.project-id == "": Heading { text: "选择或添加游戏"; font-size: 24px; }
                if App.project-id != "": VerticalLayout { spacing: 12px;
                    HorizontalLayout { spacing: 16px;
                        Heading { text: App.project-name; font-size: 24px; wrap: no-wrap; overflow: elide; min-width: 0px; max-width: parent.width - 200px; horizontal-stretch: 0; }
                        VerticalLayout { alignment: center; horizontal-stretch: 0;
                            HorizontalLayout { spacing: 16px;
                                Link { text: "项目文件"; font-size: 13px; clicked => { App.action("open", "project"); } }
                                Link { text: "游戏目录"; font-size: 13px; clicked => { App.action("open", "game"); } }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    ReportText { text: App.project-path; font-size: 12px; height: 20px; wrap: no-wrap; }
                    HorizontalLayout { spacing: 4px;
                        NavigationButton { text: "识别与适配"; width: 124px; selected: App.tab == 0; clicked => { App.action("tab", "0"); } }
                        NavigationButton { text: "翻译与校对"; width: 124px; selected: App.tab == 1; clicked => { App.action("tab", "1"); } }
                        NavigationButton { text: "补丁与验证"; width: 124px; selected: App.tab == 2; clicked => { App.action("tab", "2"); } }
                        NavigationButton { text: "项目设置"; width: 124px; selected: App.tab == 3; clicked => { App.action("tab", "3"); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    if App.tab == 0: Recognition {}
                    if App.tab == 1: Workbench {}
                    if App.tab == 2: PatchPage {}
                    if App.tab == 3: ProjectSettings {}
                }
                if App.project-id == "": VerticalLayout { Label { text: "添加游戏目录，然后选择识别方式。已有项目直接读取上次保存的结果。"; } Rectangle { vertical-stretch: 1; } }
                }
            }
            if App.page == 1: GlobalApis {}
            if App.page == 2: EngineLibrary {}
            if App.page == 5: ConsumptionMetrics {}
            if App.page == 3: VerticalLayout { spacing: 18px;
                Heading { text: "程序设置"; font-size: 26px; }
                Label { text: "数据保存位置"; font-weight: 600; }
                LineEdit { text: App.data-directory; read-only: true; }
                HorizontalLayout { Button { text: "更换保存位置"; clicked => { App.action("directory-dialog", ""); } } Button { text: "打开数据目录"; clicked => { App.action("open", "data"); } } Rectangle { horizontal-stretch: 1; } }
                Caption { text: "可迁移现有数据或仅切换目录，完成后立即生效。运行中的任务会先暂停并保存进度。"; }
                Divider {} Label { text: "同时翻译的游戏数量"; }
                HorizontalLayout { SpinBox { value <=> App.concurrency; minimum: 1; maximum: 8; } Rectangle { horizontal-stretch: 1; } }
                HorizontalLayout { Button { text: "保存程序设置"; primary: true; clicked => { App.action("save-application", ""); } } Rectangle { horizontal-stretch: 1; } }
                Rectangle { vertical-stretch: 1; }
            }
            if App.page == 4: About {}
            if App.busy || App.activity != "" || App.error != "" || App.recognition-failure-message != "": TaskFeedback {}
            if App.page == 0: VerticalLayout { spacing: 8px; vertical-stretch: 0;
                Divider {}
                HorizontalLayout { spacing: 16px;
                    Caption { text: "日志"; }
                    Link { text: "回到最新"; font-size: 13px; enabled: !logs.follow-tail; clicked => { logs.follow-tail = true; logs.scroll-to-end(); } }
                    Link { text: "打开日志目录"; font-size: 13px; enabled: App.project-id != ""; clicked => { App.action("open", "logs"); } }
                    Rectangle { horizontal-stretch: 1; }
                }
                Rectangle { height: 128px; background: Theme.surface; border-color: Theme.line; border-width: 1px;
                    logs := ScrollView {
                        property <bool> follow-tail: true;
                        property <string> project-key: App.project-id;
                        content-width: self.visible-width;
                        content-height: max(self.visible-height, log-content.height + 20px);
                        horizontal-scrollbar-policy: always-off;
                        function scroll-to-end() { self.content-y = min(0px, self.visible-height - self.content-height); }
                        init => { self.scroll-to-end(); }
                        changed content-y => { self.follow-tail = self.content-y <= self.visible-height - self.content-height + 2px; }
                        changed project-key => { self.follow-tail = true; self.scroll-to-end(); }
                        changed content-height => { if self.follow-tail { self.scroll-to-end(); } }
                        changed visible-height => { if self.follow-tail { self.scroll-to-end(); } }
                        log-content := ReportText {
                            x: 12px; y: 10px; width: logs.visible-width - 32px; height: self.preferred-height;
                            text: App.log-text; color: Theme.secondary; font-size: 13px; line-height-factor: 1.25; wrap: word-wrap;
                            horizontal-alignment: left; vertical-alignment: top;
                            changed text => { if logs.follow-tail { logs.scroll-to-end(); } }
                        }
                    }
                }
            }
        }
    }
    if App.modal != "": DialogLayer {}
}
