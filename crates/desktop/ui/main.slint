import { Button, LineEdit, CheckBox, SpinBox, ScrollView, ListView } from "std-widgets.slint";
import { App, Theme, Label, Caption, Heading, SectionHeading, ReportText, Divider, ProjectRow, TextRow, NamedRow, EngineRow, TermRow, TokenDisplay, CleanupRow } from "state.slint";
import { ProjectSettings, GlobalApis } from "settings.slint";
import { Workbench } from "workbench.slint";
import { Recognition, PatchPage, TaskFeedback } from "project.slint";
import { EngineLibrary } from "catalog.slint";
import { DialogLayer } from "dialogs.slint";
import { ConsumptionMetrics } from "metrics.slint";
export { App, ProjectRow, TextRow, NamedRow, EngineRow, TermRow, TokenDisplay, CleanupRow, MetricGroupRow, ConsumptionRow } from "state.slint";

export component MainWindow inherits Window {
    title: "GameL10n"; preferred-width: 1420px; preferred-height: 900px; min-width: 1120px; min-height: 720px;
    icon: @image-url("../assets/GameL10n.png");
    default-font-family: "Microsoft YaHei UI"; default-font-size: 14px; background: Theme.background;
    HorizontalLayout { padding: 20px; spacing: 20px;
        VerticalLayout { width: 240px; spacing: 12px;
            Heading { text: "游戏项目"; font-size: 22px; }
            Button { text: "添加游戏"; enabled: App.ready && !App.adding-game; clicked => { App.action("browse", ""); } }
            HorizontalLayout { Button { text: "多选"; checkable: true; checked <=> App.multi-projects; } Button { text: "移除"; enabled: App.project-id != "" || App.selected-projects > 0; clicked => { App.action("remove-dialog", ""); } } }
            LineEdit { text <=> App.project-query; placeholder-text: "搜索名称或路径"; edited => { App.action("projects", ""); } }
            ListView { vertical-stretch: 1; content-y <=> App.project-scroll-y;
                for project in App.projects: Rectangle { height: App.project-row-height; clip: true; background: project.id == App.project-id ? Theme.tint : transparent; border-radius: 4px;
                    HorizontalLayout { padding: 8px; spacing: 6px;
                        if App.multi-projects: CheckBox { checked: project.selected; toggled => { App.action("toggle-project", project.id); } }
                        Rectangle { horizontal-stretch: 1;
                            VerticalLayout { spacing: 4px; alignment: start;
                                Label { text: App.concise-text(project.name); height: 22px; color: Theme.title; font-weight: 600; overflow: elide; wrap: no-wrap; }
                                Caption { text: App.concise-text(project.status); height: 20px; line-height-factor: 1; color: project.running ? Theme.accent : Theme.secondary; overflow: elide; wrap: no-wrap; }
                                Caption { text: App.concise-text(project.path); height: 18px; font-size: 12px; line-height-factor: 1; overflow: elide; wrap: no-wrap; }
                            }
                            TouchArea { clicked => { App.action("project", project.id); } }
                        }
                    }
                }
            }
            Divider {}
            Button { text: "API 与任务默认值"; checked: App.page == 1; clicked => { App.action("navigate", "apis"); } }
            Button { text: "全局引擎库"; checked: App.page == 2; clicked => { App.action("navigate", "catalog"); } }
            Button { text: "消耗指标"; checked: App.page == 5; clicked => { App.action("navigate", "metrics"); } }
            Button { text: "程序设置"; checked: App.page == 3; clicked => { App.action("navigate", "settings"); } }
            Button { text: "关于"; checked: App.page == 4; clicked => { App.action("navigate", "about"); } }
        }
        VerticalLayout { spacing: 12px;
            if App.page == 0: VerticalLayout { spacing: 12px; vertical-stretch: 1;
                Heading { text: App.project-name == "" ? "选择或添加游戏" : App.project-name; font-size: 26px; wrap: no-wrap; overflow: elide; }
                if App.project-id != "": VerticalLayout { spacing: 12px;
                    HorizontalLayout { spacing: 8px;
                        Button { text: "开始全量翻译"; width: 128px; enabled: !App.busy; clicked => { App.action("translate", "all"); } }
                        Button { text: "暂停"; width: 80px; enabled: App.busy; clicked => { App.action("cancel", ""); } }
                        Button { text: "生成补丁"; width: 112px; enabled: !App.busy; clicked => { App.action("patch-dialog", ""); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    HorizontalLayout { Button { text: "识别与适配"; checked: App.tab == 0; clicked => { App.action("tab", "0"); } } Button { text: "翻译与校对"; checked: App.tab == 1; clicked => { App.action("tab", "1"); } } Button { text: "补丁与验证"; checked: App.tab == 2; clicked => { App.action("tab", "2"); } } Button { text: "项目设置"; checked: App.tab == 3; clicked => { App.action("tab", "3"); } } Rectangle { horizontal-stretch: 1; } }
                    if App.tab == 0: Recognition {}
                    if App.tab == 1: Workbench {}
                    if App.tab == 2: PatchPage {}
                    if App.tab == 3: ProjectSettings {}
                }
                if App.project-id == "": VerticalLayout { Label { text: "添加游戏目录，然后选择识别方式。已有项目直接读取上次保存的结果。"; } Rectangle { vertical-stretch: 1; } }
            }
            if App.page == 1: GlobalApis {}
            if App.page == 2: EngineLibrary {}
            if App.page == 5: ConsumptionMetrics {}
            if App.page == 3: VerticalLayout { spacing: 18px;
                Heading { text: "程序设置"; font-size: 26px; }
                Label { text: "数据保存位置"; font-weight: 600; }
                LineEdit { text: App.data-directory; read-only: true; }
                HorizontalLayout { Button { text: "更换保存位置"; clicked => { App.action("directory-dialog", ""); } } Button { text: "打开数据目录"; clicked => { App.action("open", "data"); } } Rectangle { horizontal-stretch: 1; } }
                Caption { text: "可迁移现有数据或仅切换目录，完成后立即生效。运行中的任务会先暂停并保存进度。"; }
                Divider {} Label { text: "同时翻译的游戏数量"; }
                HorizontalLayout { SpinBox { value <=> App.concurrency; minimum: 1; maximum: 8; } Rectangle { horizontal-stretch: 1; } }
                HorizontalLayout { Button { text: "保存程序设置"; primary: true; clicked => { App.action("save-application", ""); } } Rectangle { horizontal-stretch: 1; } }
                Rectangle { vertical-stretch: 1; }
            }
            if App.page == 4: VerticalLayout { spacing: 18px;
                Heading { text: "关于 GameL10n"; font-size: 26px; }
                Label { text: "版本号"; font-weight: 600; }
                LineEdit { text: App.software-version; read-only: true; }
                Label { text: "构建 Git hash"; font-weight: 600; }
                LineEdit { text: App.build-git-hash == "unknown" ? "未知" : App.build-git-hash; read-only: true; }
                Rectangle { vertical-stretch: 1; }
            }
            if (App.page == 0 && App.project-id != "" && !(App.tab == 0 && App.recognition-running) && (App.tab != 0 || !App.recognition-ready || App.busy)) || App.activity != "" || App.error != "": TaskFeedback {}
            if App.page == 0: VerticalLayout { spacing: 8px; vertical-stretch: 0;
                HorizontalLayout { spacing: 8px;
                    SectionHeading { text: "实时日志"; }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "回到最新"; enabled: !logs.follow-tail; clicked => { logs.follow-tail = true; logs.scroll-to-end(); } }
                    Button { text: "打开日志目录"; enabled: App.project-id != ""; clicked => { App.action("open", "logs"); } }
                }
                Rectangle { height: 112px; background: Theme.surface; border-color: Theme.line; border-width: 1px;
                    logs := ScrollView {
                        property <bool> follow-tail: true;
                        property <string> project-key: App.project-id;
                        content-width: self.visible-width;
                        content-height: max(self.visible-height, log-content.height + 20px);
                        horizontal-scrollbar-policy: always-off;
                        function scroll-to-end() { self.content-y = min(0px, self.visible-height - self.content-height); }
                        init => { self.scroll-to-end(); }
                        changed content-y => { self.follow-tail = self.content-y <= self.visible-height - self.content-height + 2px; }
                        changed project-key => { self.follow-tail = true; self.scroll-to-end(); }
                        changed content-height => { if self.follow-tail { self.scroll-to-end(); } }
                        changed visible-height => { if self.follow-tail { self.scroll-to-end(); } }
                        log-content := ReportText {
                            x: 12px; y: 10px; width: logs.visible-width - 32px; height: self.preferred-height;
                            text: App.log-text; color: Theme.secondary; font-size: 13px; line-height-factor: 1.25; wrap: word-wrap;
                            horizontal-alignment: left; vertical-alignment: top;
                            changed text => { if logs.follow-tail { logs.scroll-to-end(); } }
                        }
                    }
                }
            }
        }
    }
    if App.modal != "": DialogLayer {}
}
