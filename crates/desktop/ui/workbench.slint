import { LineEdit, TextEdit, ComboBox, CheckBox, ScrollView, ListView } from "std-widgets.slint";
import { App, Theme, Label, Caption, Heading, Link, IconButton, ActionButton, CopyButton, ClipboardBuffer, ReportText, Badge } from "state.slint";

component SelectableText inherits ReportText {
    callback activated;
    changed has-focus => { if self.has-focus { root.activated(); } }
}

component TextColumns inherits Rectangle {
    out property <length> column-width: max(0px, (self.width - 16px) / 2);
    out property <length> translation-x: self.column-width + 16px;
}

component TextCell inherits Rectangle {
    in property <string> value;
    in property <string> copy-label;
    in property <color> text-color: Theme.ink;
    in property <bool> show-copy;
    callback activated;
    callback copy(string);
    clip: true;
    SelectableText {
        x: 0px; y: 0px; width: max(0px, parent.width - copy-button.width - 4px); height: parent.height;
        text: root.value; color: root.text-color; enabled: !App.loading;
        activated => { root.activated(); }
    }
    copy-button := CopyButton {
        x: parent.width - self.width; y: 0px; label: root.copy-label; value: root.value;
        opacity: root.show-copy || self.highlighted ? 1 : 0.22;
        copy(value) => { root.copy(value); }
    }
}

export component Workbench inherits FocusScope {
    property <bool> selection-enabled: !App.loading && !App.selection-busy;
    property <bool> editor-details;
    property <bool> has-active-filters: App.text-query != "" || App.resource-filter > 0 || App.kind-filter > 0 || App.status-filter > 0 || App.only-selected;
    private property <string> editor-key: App.editor-id;
    changed editor-key => { self.editor-details = false; }
    private property <string> candidate-key: App.candidate;
    changed candidate-key => { if self.candidate-key != "" { self.editor-details = true; } }
    property <bool> editor-ready: App.editor-id != "" && root.selection-enabled;
    clipboard := ClipboardBuffer {}
    key-pressed(event) => {
        if App.modal != "" { return reject; }
        if event.modifiers.control && (event.text == "k" || event.text == "K") { search-input.focus(); return accept; }
        if root.editor-ready && App.editor-editable && event.modifiers.control && (event.text == "s" || event.text == "S") { App.action("save-edit", ""); return accept; }
        if root.editor-ready && App.editor-editable && event.modifiers.control && event.text == Key.Return { App.action("review-next", ""); return accept; }
        if root.editor-ready && event.modifiers.alt && event.text == Key.UpArrow { App.action("editor-step", "-1"); return accept; }
        if root.editor-ready && event.modifiers.alt && event.text == Key.DownArrow { App.action("editor-step", "1"); return accept; }
        return reject;
    }
    VerticalLayout {
    spacing: 8px;
    HorizontalLayout { spacing: 8px;
        ActionButton {
            text: App.preview-translation-resumable && !App.preview-translation-running ? "继续翻译…" : "全量翻译";
            icon: "languages";
            primary: App.selected-texts == 0;
            enabled: App.can-start-translation && (App.has-workbench-text || App.preview-translation-resumable);
            clicked => { App.action("translate", "all"); }
        }
        ActionButton {
            text: "生成补丁"; icon: "package";
            enabled: App.selected-texts > 0 && root.selection-enabled && !App.busy;
            tooltip: "使用所选文本生成补丁，缺少的译文会先自动翻译。";
            clicked => { App.action("translate", "trial"); }
        }
        ActionButton {
            text: "安装补丁"; icon: "download";
            enabled: App.can-install-patch;
            tooltip: "安装本项目最近生成的补丁。";
            clicked => { App.modal = "install"; }
        }
        ActionButton {
            text: "提取术语"; icon: "sparkles";
            enabled: !App.busy && App.has-workbench-text && App.has-json-batch-api && !App.terminology-extracting;
            tooltip: App.has-json-batch-api ? "使用批量 JSON 翻译 API 自动提取角色名与术语" : "需在项目翻译链中配置批量 JSON 格式的 API";
            clicked => { App.action("terminology-extract", ""); }
        }
        Caption {
            text: (App.translation-preview ? (App.task-operation == "workflow" ? "识别中 · 自动汉化将在确定试译文本后试译 · " : "识别中 · ") : "") + App.counts;
            horizontal-stretch: 1; min-width: 0px; vertical-alignment: center; overflow: elide; wrap: no-wrap;
        }
    }
    HorizontalLayout { spacing: 8px;
        search-input := LineEdit { placeholder-text: "搜索原文、译文或位置 (Ctrl+K)"; text <=> App.text-query; edited => { App.action("texts", "0"); } horizontal-stretch: 1; min-width: 120px; }
        ComboBox { model: App.resources; current-index <=> App.resource-filter; width: 150px; selected => { App.action("texts", "0"); } }
        ComboBox { model: ["全部类型", "对白 / 旁白", "角色名", "选项", "菜单 / 界面", "物品 / 装备", "技能 / 天赋", "提示 / 说明"]; current-index <=> App.kind-filter; width: 120px; selected => { App.action("texts", "0"); } }
        ComboBox { model: ["全部状态与来源", "未翻译", "待校对", "已校对", "已保护译文", "格式问题", "翻译失败", "有候选", "自动译文", "人工译文", "历史来源未记录"]; current-index <=> App.status-filter; width: 156px; selected => { App.action("texts", "0"); } }
        if root.has-active-filters: IconButton {
            icon: "filter-x"; button-size: 30px; icon-size: 15px;
            tooltip: "清除全部搜索与筛选条件";
            clicked => {
                App.text-query = ""; App.resource-filter = 0; App.kind-filter = 0; App.status-filter = 0; App.only-selected = false;
                App.action("texts", "0");
            }
        }
    }
    Rectangle {
        border-radius: 5px;
        background: App.selected-texts > 0 ? Theme.tint : transparent;
        HorizontalLayout {
            padding-top: 4px; padding-bottom: 4px;
            padding-left: App.selected-texts > 0 ? 10px : 0px;
            padding-right: App.selected-texts > 0 ? 8px : 0px;
            spacing: 8px;
            VerticalLayout { alignment: center; horizontal-stretch: 0;
                HorizontalLayout { spacing: 12px;
                    if App.selected-texts == 0: Link { text: "选本页"; enabled: root.selection-enabled && App.texts.length > 0; clicked => { App.action("select-page", ""); } }
                    if App.selected-texts == 0: Link { text: "全选匹配"; enabled: root.selection-enabled && App.text-total > 0; clicked => { App.action("select-matching", ""); } }
                }
            }
            if App.selected-texts > 0 || App.selection-busy: Caption {
                text: App.selection-busy ? "更新中…" : "已选 " + App.selected-texts + " 条";
                color: Theme.accent; font-weight: 600; vertical-alignment: center; wrap: no-wrap;
            }
            if App.selected-texts > 0: ActionButton {
                text: "翻译所选"; icon: "languages"; primary: true; compact: true;
                enabled: root.selection-enabled && App.can-start-translation && (!App.busy || App.translation-preview);
                clicked => { App.action("translate", "selected"); }
            }
            if App.selected-texts > 0: ActionButton {
                text: "重新翻译"; icon: "refresh"; compact: true;
                tooltip: "重新翻译所选文本";
                enabled: root.selection-enabled && !App.busy;
                clicked => { App.action("retranslate-dialog", ""); }
            }
            if App.selected-texts > 0: ActionButton {
                text: "批量确认校对"; icon: "check-square"; compact: true;
                enabled: root.selection-enabled && App.editor-editable;
                clicked => { App.action("bulk-review", ""); }
            }
            CheckBox { text: "仅显示已选"; checked <=> App.only-selected; enabled: App.selected-texts > 0 || App.only-selected; toggled => { App.action("texts", "0"); } }
            if App.selected-texts > 0: ActionButton {
                text: "取消选择"; icon: "close"; subtle: true; compact: true;
                tooltip: "取消全部选择";
                enabled: root.selection-enabled;
                clicked => { App.action("select-clear", ""); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
    if App.terminology-affected-count > 0: Rectangle {
        height: affected-banner.preferred-height + 10px;
        background: Theme.tint;
        border-color: Theme.accent.with-alpha(0.3);
        border-width: 1px;
        border-radius: 5px;
        affected-banner := HorizontalLayout {
            x: 10px; y: 5px; width: parent.width - 20px; height: self.preferred-height; spacing: 8px;
            Label {
                text: "术语表已更新：有 " + App.terminology-affected-count + " 条已译文本包含变更的术语。";
                font-size: 13px; horizontal-stretch: 1; min-width: 0px; vertical-alignment: center;
            }
            ActionButton {
                text: "选中受影响文本"; icon: "check-square"; compact: true;
                enabled: root.selection-enabled;
                clicked => { App.action("terminology-select-affected", ""); }
            }
            IconButton {
                icon: "close"; button-size: 26px; icon-size: 14px;
                tooltip: "关闭提示";
                clicked => { App.action("terminology-dismiss-affected", ""); }
            }
        }
    }
    HorizontalLayout { spacing: 12px;
        VerticalLayout { spacing: 8px; horizontal-stretch: 2;
            if App.texts.length > 0: VerticalLayout { spacing: 6px;
                Rectangle { height: source-heading.preferred-height;
                    TextColumns { x: 34px; width: text-list.visible-width - self.x - 8px; height: parent.height;
                        source-heading := Caption { x: 0px; width: parent.column-width; text: "原文"; wrap: no-wrap; }
                        Caption { x: parent.translation-x; width: parent.column-width; text: "译文"; wrap: no-wrap; }
                    }
                }
                text-list := ListView { vertical-stretch: 1; content-y <=> App.text-scroll-y; horizontal-scrollbar-policy: always-off;
                    for row in App.texts: Rectangle {
                        width: text-list.visible-width; height: 132px; background: row.id == App.editor-id ? Theme.tint : Theme.surface;
                        if row.id == App.editor-id: Rectangle { x: 0px; y: 8px; width: 3px; height: parent.height - 16px; background: Theme.accent; }
                        HorizontalLayout { padding: 8px; spacing: 8px;
                            CheckBox { width: 18px; checked: row.selected; enabled: root.selection-enabled; toggled => { App.action("toggle-text", row.id); } }
                            Rectangle { horizontal-stretch: 1; min-width: 0px;
                                VerticalLayout { spacing: 3px;
                                    Rectangle { height: 18px;
                                        Caption { text: row.location; width: parent.width; height: parent.height; overflow: elide; wrap: no-wrap; }
                                        TouchArea { enabled: !App.loading; mouse-cursor: pointer; clicked => { App.action("edit-text", row.id); } }
                                    }
                                    HorizontalLayout { spacing: 6px; height: 24px;
                                        Badge { text: row.translation == "" ? "未翻译" : row.origin == 1 ? "自动" : row.origin == 2 ? "人工" : "来源未知"; tone: row.translation == "" ? 0 : row.origin; }
                                        if row.invalid || row.translation != "": Badge { text: row.invalid ? "格式问题" : row.reviewed ? "已校对" : "待校对"; tone: row.invalid ? 5 : row.reviewed ? 3 : 4; }
                                        if row.failed: Badge { text: "请求失败"; tone: 5; }
                                        if row.candidate: Badge { text: "有候选"; tone: 1; }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                    TextColumns { height: 44px;
                                        TextCell {
                                            x: 0px; width: parent.column-width; height: parent.height;
                                            value: row.source; text-color: Theme.secondary; copy-label: "复制原文";
                                            show-copy: row.id == App.editor-id;
                                            activated => { if row.id != App.editor-id { App.action("edit-text", row.id); } }
                                            copy(value) => { clipboard.copy-text(value); }
                                        }
                                        TextCell {
                                            x: parent.translation-x; width: parent.column-width; height: parent.height;
                                            value: row.translation; copy-label: "复制译文";
                                            show-copy: row.id == App.editor-id;
                                            activated => { if row.id != App.editor-id { App.action("edit-text", row.id); } }
                                            copy(value) => { clipboard.copy-text(value); }
                                        }
                                    }
                                    Rectangle { height: 16px;
                                        Caption { text: row.metadata; width: parent.width; height: parent.height; overflow: elide; wrap: no-wrap; }
                                        TouchArea { enabled: !App.loading; mouse-cursor: pointer; clicked => { App.action("edit-text", row.id); } }
                                    }
                                }
                            }
                        }
                        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                    }
                }
            }
            if App.texts.length == 0: VerticalLayout { padding: 12px; spacing: 8px; alignment: start; vertical-stretch: 1;
                Caption {
                    text: App.loading ? "正在加载文本…"
                        : !App.has-workbench-text ? (App.preview-translation-resumable ? "可继续上次翻译。识别完成后可查看正式文本。"
                            : App.preview-translation-running ? "正在翻译上次提取的文本。识别完成后可查看正式文本。"
                            : App.recognition-running || (App.busy && App.task-operation == "workflow") ? "正在识别游戏。原文通过重复提取检查后会显示在这里。"
                            : "尚未提取文本，请先进行识别与适配。")
                        : "没有符合条件的文本。";
                }
                if !App.loading && !App.busy && !App.has-workbench-text: Link { text: "前往识别与适配"; clicked => { App.action("tab", "0"); } }
                if !App.loading && App.has-workbench-text && root.has-active-filters: Link {
                    text: "清除筛选";
                    clicked => {
                        App.text-query = ""; App.resource-filter = 0; App.kind-filter = 0; App.status-filter = 0; App.only-selected = false;
                        App.action("texts", "0");
                    }
                }
            }
            if App.text-total > 0: text-paging := HorizontalLayout { spacing: 6px;
                private property <bool> multiple-pages: App.offset > 0 || App.shown < App.text-total;
                Caption { text: text-paging.multiple-pages ? (App.offset + 1) + "–" + (App.offset + App.shown) + " / " + App.text-total : "共 " + App.text-total + " 条"; horizontal-stretch: 0; vertical-alignment: center; wrap: no-wrap; }
                if text-paging.multiple-pages: IconButton {
                    icon: "chevron-left"; button-size: 28px; icon-size: 16px;
                    tooltip: "上一页";
                    enabled: App.offset > 0 && root.selection-enabled;
                    clicked => { App.action("texts", "previous"); }
                }
                if text-paging.multiple-pages: IconButton {
                    icon: "chevron-right"; button-size: 28px; icon-size: 16px;
                    tooltip: "下一页";
                    enabled: App.offset + App.shown < App.text-total && root.selection-enabled;
                    clicked => { App.action("texts", "next"); }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
        if App.editor-id != "": Rectangle { preferred-width: 332px; min-width: 280px; max-width: 390px; horizontal-stretch: 1; background: Theme.card; border-color: Theme.line; border-width: 1px; border-radius: 6px;
            VerticalLayout { padding: 12px; spacing: 8px;
                HorizontalLayout { spacing: 6px;
                    Heading { text: "校对"; font-size: 16px; vertical-alignment: center; }
                    Badge { text: App.editor-text == "" ? "未翻译" : App.editor-dirty || App.editor-origin == 2 ? "人工" : App.editor-origin == 1 ? "自动" : "来源未知"; tone: App.editor-text == "" ? 0 : App.editor-dirty ? 2 : App.editor-origin; }
                    if App.editor-invalid || App.editor-text != "": Badge { text: App.editor-invalid ? "格式问题" : App.editor-reviewed && !App.editor-dirty ? "已校对" : "待校对"; tone: App.editor-invalid ? 5 : App.editor-reviewed && !App.editor-dirty ? 3 : 4; }
                    Rectangle { horizontal-stretch: 1; }
                    IconButton {
                        icon: "arrow-up"; button-size: 28px; icon-size: 15px;
                        tooltip: "上一条文本 (Alt+↑)";
                        enabled: root.editor-ready;
                        clicked => { App.action("editor-step", "-1"); }
                    }
                    IconButton {
                        icon: "arrow-down"; button-size: 28px; icon-size: 15px;
                        tooltip: "下一条文本 (Alt+↓)";
                        enabled: root.editor-ready;
                        clicked => { App.action("editor-step", "1"); }
                    }
                }
                HorizontalLayout { spacing: 10px;
                    Label { text: "原文"; font-weight: 600; vertical-alignment: center; }
                    Link { text: root.editor-details ? "收起详情" : App.editor-has-issues || App.candidate != "" ? "查看问题与候选" : "展开详情"; font-size: 13px; clicked => { root.editor-details = !root.editor-details; } }
                    Rectangle { horizontal-stretch: 1; }
                    CopyButton { label: "复制原文"; value: root.editor-ready ? App.editor-source : ""; copy(value) => { clipboard.copy-text(value); } }
                }
                ScrollView { vertical-stretch: root.editor-details ? 2 : 1; min-height: 88px; content-y <=> App.editor-scroll-y;
                    VerticalLayout { spacing: 8px;
                        if !root.editor-ready: Caption { text: "选择一条文本开始校对"; }
                        SelectableText { text: App.editor-source; }
                        if root.editor-details && App.editor-validation != "": ReportText { text: App.editor-validation; color: App.editor-has-issues ? Theme.error : Theme.secondary; }
                        if root.editor-details && App.editor-reviewed: HorizontalLayout {
                            ActionButton { text: "标为待校对"; compact: true; enabled: App.editor-editable; clicked => { App.action("unreview", ""); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        if root.editor-details: Caption { text: App.editor-location; }
                        if root.editor-details && App.editor-context != "": VerticalLayout {
                            Caption { text: "相邻文本与上下文"; }
                            SelectableText { text: App.editor-context; color: Theme.muted; font-size: 13px; }
                        }
                        if root.editor-details && App.editor-draft != "": VerticalLayout { Caption { text: "模型初稿"; } SelectableText { text: App.editor-draft; color: Theme.muted; font-size: 13px; } }
                        if root.editor-details && App.terms.length > 0: Caption { text: "相关术语 · 点击插入"; }
                        if root.editor-details: VerticalLayout { spacing: 4px;
                            for term in App.terms: ActionButton { text: term.source + " → " + term.target; compact: true; enabled: App.editor-editable; clicked => { translation-editor.focus(); App.action("insert-term", term.target); } }
                        }
                        if root.editor-details && App.candidate != "": VerticalLayout { spacing: 6px;
                            Label { text: "新候选"; font-weight: 600; }
                            SelectableText { text: App.candidate; }
                            HorizontalLayout { spacing: 6px;
                                ActionButton { text: "采用候选"; icon: "check"; primary: true; compact: true; enabled: App.editor-editable; clicked => { App.action("accept-candidate", ""); } }
                                ActionButton { text: "放弃候选"; compact: true; enabled: App.editor-editable; clicked => { App.action("discard-candidate", ""); } }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                        if root.editor-details: HorizontalLayout {
                            ActionButton { text: "撤销已保存修改"; icon: "rotate-ccw"; compact: true; enabled: root.editor-ready && App.editor-editable; clicked => { App.action("undo-edit", ""); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }
                HorizontalLayout { spacing: 6px;
                    Label { text: "译文"; font-weight: 600; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    ActionButton {
                        text: "添加术语"; icon: "plus"; subtle: true; compact: true;
                        tooltip: "将人名或专有名词快速添加到术语表";
                        enabled: root.editor-ready;
                        clicked => { App.action("add-term-dialog", ""); }
                    }
                    CopyButton { label: "复制译文"; value: root.editor-ready ? App.editor-text : ""; copy(value) => { clipboard.copy-text(value); } }
                }
                translation-editor := TextEdit { text <=> App.editor-text; min-height: 96px; vertical-stretch: 1; enabled: root.editor-ready; read-only: !App.editor-editable; edited => { App.editor-dirty = true; App.action("edit-changed", ""); } }
                if App.editor-dirty || App.editor-status != "": Caption { text: App.editor-dirty ? "未保存" : App.editor-status; color: App.editor-dirty ? Theme.pending : Theme.secondary; wrap: no-wrap; overflow: elide; }
                HorizontalLayout { spacing: 6px;
                    IconButton {
                        icon: "save"; button-size: 30px; icon-size: 15px;
                        tooltip: "保存译文 (Ctrl+S)";
                        enabled: root.editor-ready && App.editor-editable;
                        clicked => { App.action("save-edit", ""); }
                    }
                    ActionButton {
                        text: "新候选"; icon: "sparkles"; compact: true;
                        tooltip: "调用模型为当前条重新生成候选译文";
                        enabled: root.editor-ready && !App.busy;
                        clicked => { App.action("candidate", ""); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    ActionButton {
                        text: "确认并下一条"; icon: "check"; primary: true; compact: true;
                        tooltip: "确认校对并切换到下一条 (Ctrl+Enter)";
                        enabled: root.editor-ready && App.editor-editable;
                        clicked => { App.action("review-next", ""); }
                    }
                }
            }
        }
    }
    }
}
