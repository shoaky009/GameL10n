import { ComboBox, SpinBox, TextEdit, ScrollView, ProgressIndicator } from "std-widgets.slint";
import { App, Theme, Caption, Label, ReportText, Divider, ActionButton } from "state.slint";

export component GameCheckControls inherits VerticalLayout {
    in property <length> settings-height: 300px;
    spacing: 12px;
    Caption { text: App.launch-summary; }
    HorizontalLayout { spacing: 12px;
        Caption { text: "启动检查"; width: 64px; }
        ReportText { text: App.check-launch-result; color: App.check-launch-failed ? Theme.error : Theme.ink; horizontal-stretch: 1; min-width: 0px; }
    }
    HorizontalLayout { spacing: 12px;
        Caption { text: "译文检查"; width: 64px; }
        ReportText { text: App.check-text-result; color: App.check-text-failed ? Theme.error : Theme.ink; horizontal-stretch: 1; min-width: 0px; }
    }
    HorizontalLayout { spacing: 8px;
        ActionButton { text: "检查启动"; icon: "play"; compact: true; enabled: !App.check-running && !App.busy && App.launch-can-run; clicked => { App.action("game-check-run", "launch"); } }
        ActionButton { text: "检查当前译文"; icon: "check-square"; compact: true; enabled: !App.check-running && !App.busy && App.launch-can-run && App.check-has-expected; clicked => { App.action("game-check-run", "text"); } }
        ActionButton { text: "启动并检查"; icon: "play"; primary: true; compact: true; enabled: !App.check-running && !App.busy && App.launch-can-run && App.check-has-expected; clicked => { App.action("game-check-run", "both"); } }
        Rectangle { horizontal-stretch: 1; }
        if App.check-running: ActionButton { text: "停止"; icon: "stop"; danger: true; compact: true; clicked => { App.action("game-check-cancel", ""); } }
    }
    if App.check-running: ProgressIndicator { height: 3px; indeterminate: true; }
    if App.check-message != "": ReportText { text: App.check-message; color: Theme.error; }
    Divider {}
    ScrollView { height: root.settings-height; horizontal-scrollbar-policy: always-off; content-width: self.visible-width;
        VerticalLayout { padding-right: 12px; spacing: 10px; alignment: start;
            Caption { text: "验证场景"; }
            ComboBox {
                model: ["启动后直接检查", "启动后按 Enter", "自定义场景操作"];
                current-index <=> App.check-scene;
                enabled: !App.check-running;
            }
            if App.check-scene == 2: VerticalLayout { spacing: 6px;
                TextEdit { text <=> App.check-steps; height: 90px; enabled: !App.check-running; }
                Caption { text: "每行一个操作，如等待 1000、按键 Enter、点击 50 50。等待单位为毫秒，点击坐标为百分比。"; }
            }
            Divider {}
            Caption { text: App.check-unit-ids.length == 0 ? "检查目标（未选择）" : "检查目标 · " + App.check-unit-ids.length + " 条"; }
            if App.check-expected != "": ReportText { text: App.check-expected; }
            HorizontalLayout { spacing: 8px;
                ActionButton { text: "使用文本页选区"; compact: true; enabled: !App.check-running; clicked => { App.action("game-check-selection", ""); } }
                ActionButton { text: "选择文本…"; icon: "languages"; compact: true; enabled: !App.check-running; clicked => { App.modal = ""; App.action("tab", "1"); } }
                Rectangle { horizontal-stretch: 1; }
                if App.check-unit-ids.length > 0: ActionButton { text: "清除目标"; icon: "trash"; danger: true; compact: true; enabled: !App.check-running; clicked => { App.action("game-check-selection", "clear"); } }
            }
            if App.check-has-expected: Caption { text: "任意一条所选译文稳定出现即通过。"; }
            Divider {}
            HorizontalLayout { spacing: 10px;
                Label { text: "识别语言"; vertical-alignment: center; }
                ComboBox { model: ["简体中文", "繁体中文", "日语", "英语"]; current-index <=> App.check-language; enabled: !App.check-running; horizontal-stretch: 1; }
                Label { text: "启动等待（秒）"; vertical-alignment: center; }
                SpinBox { minimum: 5; maximum: 120; value <=> App.check-timeout; enabled: !App.check-running; width: 90px; }
            }
            Caption { text: "文本区域（游戏客户区的百分比）"; }
            GridLayout { spacing: 8px;
                Row {
                    Label { text: "左"; vertical-alignment: center; } SpinBox { minimum: 0; maximum: 99; value <=> App.check-left; enabled: !App.check-running; horizontal-stretch: 1; }
                    Label { text: "上"; vertical-alignment: center; } SpinBox { minimum: 0; maximum: 99; value <=> App.check-top; enabled: !App.check-running; horizontal-stretch: 1; }
                }
                Row {
                    Label { text: "宽"; vertical-alignment: center; } SpinBox { minimum: 1; maximum: 100; value <=> App.check-width; enabled: !App.check-running; horizontal-stretch: 1; }
                    Label { text: "高"; vertical-alignment: center; } SpinBox { minimum: 1; maximum: 100; value <=> App.check-height; enabled: !App.check-running; horizontal-stretch: 1; }
                }
            }
        }
    }
}
