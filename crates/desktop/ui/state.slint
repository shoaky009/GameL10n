export component Label inherits Text { color: Theme.ink; font-size: 14px; line-height-factor: 1.2; wrap: word-wrap; }
export component Caption inherits Text { color: Theme.muted; font-size: 13px; line-height-factor: 1.2; wrap: word-wrap; }
export component ListPanel inherits Rectangle {
    background: Theme.surface;
    border-width: 1px; border-color: Theme.line; border-radius: 5px;
    VerticalLayout { padding: root.border-width; @children }
}

export component SelectableListRow inherits Rectangle {
    in property <bool> selected;
    in property <bool> hovered;
    clip: true;
    background: root.selected ? Theme.tint : root.hovered ? Theme.hover : transparent;
    if root.selected: Rectangle {
        x: 0px; y: 9px; width: 3px; height: parent.height - 18px; background: Theme.accent;
    }
    @children
}

export component Badge inherits Rectangle {
    in property <string> text;
    in property <int> tone;
    height: 24px; width: badge-label.preferred-width + 16px; horizontal-stretch: 0;
    border-radius: 4px;
    background: tone == 1 ? Theme.automatic-bg : tone == 2 ? Theme.manual-bg : tone == 3 ? Theme.success-bg : tone == 4 ? Theme.pending-bg : tone == 5 ? Theme.error-bg : Theme.hover;
    badge-label := Text { x: 8px; height: parent.height; text: root.text; font-size: 12px; vertical-alignment: center;
        color: root.tone == 1 ? Theme.automatic : root.tone == 2 ? Theme.manual : root.tone == 3 ? Theme.success : root.tone == 4 ? Theme.pending : root.tone == 5 ? Theme.error : Theme.secondary;
    }
}

export component NavigationButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;
    height: 36px; border-radius: 5px;
    background: selected ? Theme.tint : hit.has-hover ? Theme.hover : transparent;
    border-width: keyboard.has-focus ? 1px : 0px; border-color: Theme.accent;
    accessible-role: button; accessible-label: text; accessible-action-default => { root.clicked(); }
    Text { x: 12px; width: parent.width - 24px; height: parent.height; text: root.text; color: root.selected ? Theme.accent : Theme.ink; font-weight: root.selected ? 600 : 400; vertical-alignment: center; }
    keyboard := FocusScope { key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.clicked(); return accept; } return reject; } }
    hit := TouchArea { mouse-cursor: pointer; clicked => { keyboard.focus(); root.clicked(); } }
}
component LinkControl inherits Rectangle {
    in property <bool> enabled: true;
    out property <bool> highlighted: root.enabled && (hit-target.has-hover || keyboard.has-focus);
    callback clicked;
    min-width: 0px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    forward-focus: keyboard;
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    border-radius: 2px;
    border-width: keyboard.has-focus && root.enabled ? 1px : 0px;
    border-color: Theme.accent;
    @children
    hit-target := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { keyboard.focus(); root.clicked(); }
    }
    keyboard := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}
export component Link inherits LinkControl {
    in property <string> text;
    in property <length> font-size: 14px;
    in property <bool> strong;
    accessible-label: root.text;
    VerticalLayout {
        StyledText {
            text: root.highlighted
                ? (root.strong ? @markdown("**<u>\{root.text}</u>**") : @markdown("<u>\{root.text}</u>"))
                : (root.strong ? @markdown("**\{root.text}**") : @markdown("\{root.text}"));
            default-color: root.enabled ? Theme.accent : Theme.muted;
            default-font-size: root.font-size;
            accessible-role: none;
        }
    }
}
export component HelpButton inherits LinkControl {
    in property <string> topic;
    in property <string> description;
    width: 24px; height: 24px;
    accessible-label: root.topic + "说明";
    accessible-description: root.description;
    Rectangle {
        x: 4px; y: 4px; width: 16px; height: 16px; border-radius: 8px;
        border-width: 1px; border-color: root.highlighted ? Theme.accent : Theme.muted;
        Text {
            text: "?"; font-size: 12px; font-weight: 600; color: parent.border-color;
            horizontal-alignment: center; vertical-alignment: center;
            accessible-role: none;
        }
    }
    clicked => { details.show(); }
    details := PopupWindow {
        x: 0px; y: root.height + 4px; width: 324px; height: explanation.preferred-height + 20px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.surface; border-width: 1px; border-color: Theme.line; border-radius: 5px;
            explanation := Label { x: 12px; y: 10px; width: parent.width - 24px; height: self.preferred-height; text: root.description; }
        }
    }
}

export component CopyButton inherits LinkControl {
    in property <string> label;
    in property <string> value;
    callback copy(string);
    private property <bool> copied;
    accessible-label: root.label;
    enabled: root.value != "";
    width: 24px; height: 24px;
    background: root.highlighted ? Theme.hover : transparent;
    Tooltip { text: root.copied ? @markdown("已复制") : @markdown("\{root.label}"); }
    if !root.copied: Path {
        x: 5px; y: 5px; width: 14px; height: 14px;
        viewbox-width: 16; viewbox-height: 16;
        stroke: root.enabled ? Theme.accent : Theme.muted; opacity: root.enabled ? 1 : 0.45;
        stroke-width: 1.4px;
        commands: "M 4 11 H 2 Q 1 11 1 10 V 2 Q 1 1 2 1 H 10 Q 11 1 11 2 V 4 M 6 5 H 14 Q 15 5 15 6 V 14 Q 15 15 14 15 H 6 Q 5 15 5 14 V 6 Q 5 5 6 5 Z";
    }
    if root.copied: Path {
        x: 5px; y: 5px; width: 14px; height: 14px;
        viewbox-width: 16; viewbox-height: 16;
        stroke: Theme.accent; stroke-width: 1.8px;
        commands: "M 2 8 L 6 12 L 14 3";
    }
    changed value => { root.copied = false; }
    clicked => {
        root.copy(root.value);
        root.copied = true;
        reset.restart();
    }
    reset := Timer { interval: 1200ms; running: root.copied; triggered => { root.copied = false; } }
}
export component ClipboardBuffer inherits TextInput {
    // Absolute positioning keeps the hidden buffer out of page layout constraints.
    x: 0px; y: 0px; visible: false; width: 0px; height: 0px; read-only: true;
    public function copy-text(value: string) {
        self.text = value;
        self.select-all();
        self.copy();
        self.text = "";
    }
}
export component TokenCaption inherits Caption {
    in property <TokenDisplay> value;
    text: value.text;
    if value.exact != "": Tooltip { text: @markdown("\{root.value.exact}"); }
}
export component Heading inherits Text { color: Theme.title; font-size: 20px; font-weight: 600; }
export component SectionHeading inherits Text { color: Theme.title; font-size: 16px; font-weight: 600; wrap: word-wrap; }
export component ReportText inherits TextInput {
    read-only: true;
    single-line: false;
    wrap: word-wrap;
    height: self.preferred-height;
    color: Theme.ink;
    font-size: 14px;
    line-height-factor: 1.2;
    selection-background-color: Theme.accent;
    selection-foreground-color: Theme.surface;
    vertical-alignment: top;
}
export component Divider inherits Rectangle { height: 1px; background: Theme.line; }
