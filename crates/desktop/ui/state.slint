export component Label inherits Text { color: Theme.ink; font-size: 14px; line-height-factor: 1.2; wrap: word-wrap; }
export component Caption inherits Text { color: Theme.muted; font-size: 13px; line-height-factor: 1.2; wrap: word-wrap; }
export component Link inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <length> font-size: 14px;
    in property <bool> strong;
    callback clicked;
    min-width: 0px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    forward-focus: keyboard;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    border-radius: 2px;
    border-width: keyboard.has-focus && root.enabled ? 1px : 0px;
    border-color: Theme.accent;
    VerticalLayout {
        StyledText {
            text: root.enabled && (hit-target.has-hover || keyboard.has-focus)
                ? (root.strong ? @markdown("**<u>\{root.text}</u>**") : @markdown("<u>\{root.text}</u>"))
                : (root.strong ? @markdown("**\{root.text}**") : @markdown("\{root.text}"));
            default-color: root.enabled ? Theme.accent : Theme.muted;
            default-font-size: root.font-size;
            accessible-role: none;
        }
    }
    hit-target := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { keyboard.focus(); root.clicked(); }
    }
    keyboard := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}
export component TokenCaption inherits Caption {
    in property <TokenDisplay> value;
    text: value.text;
    if value.exact != "": Tooltip { text: @markdown("\{root.value.exact}"); }
}
export component Heading inherits Text { color: Theme.title; font-size: 20px; font-weight: 600; }
export component SectionHeading inherits Text { color: Theme.title; font-size: 16px; font-weight: 600; wrap: word-wrap; }
export component ReportText inherits TextInput {
    read-only: true;
    single-line: false;
    wrap: word-wrap;
    height: self.preferred-height;
    color: Theme.ink;
    font-size: 14px;
    line-height-factor: 1.2;
    selection-background-color: Theme.accent;
    selection-foreground-color: Theme.surface;
    vertical-alignment: top;
}
export component Divider inherits Rectangle { height: 1px; background: Theme.line; }
