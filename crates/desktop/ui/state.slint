import { Palette } from "std-widgets.slint";
export struct ProjectRow { id: string, name: string, path: string, status: string, running: bool, review-running: bool, selected: bool }
export struct TextRow { id: string, location: string, source: string, translation: string, metadata: string, selected: bool, origin: int, reviewed: bool, invalid: bool, failed: bool, candidate: bool }
export struct NamedRow { id: string, name: string, detail: string, enabled: bool }
export struct EngineRow { id: string, name: string, detail: string, enabled: bool, selected: bool }
export struct TermRow { source: string, target: string }
export struct TokenDisplay { text: string, exact: string }
export struct CleanupRow { id: string, title: string, description: string, size: string, selected: bool }
export struct MetricGroupRow { label: string, detail: string, value: string, fraction: float }
export struct ConsumptionRow { identity: string, configuration: string, counters: string }
export struct TokenPoint { label: string, axis-label: string, detail: string, input: string, output: string, cached: string, x: float, input-y: float, output-y: float, cached-y: float, input-known: bool, output-known: bool, cached-known: bool, usage-partial: bool, cache-partial: bool }
export struct TokenSegment { x1: float, y1: float, x2: float, y2: float, series: int }
export struct MetricTick { label: string, fraction: float }

export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> surface: dark ? #1c2128 : #ffffff;
    out property <color> background: dark ? #15191f : #f7f8fa;
    out property <color> sidebar: dark ? #191e25 : #eef1f5;
    out property <color> hover: dark ? #29313c : #e4eaf1;
    out property <color> tint: dark ? #253c55 : #e6f0fc;
    out property <color> accent: dark ? #94c5ff : #235b99;
    out property <color> title: dark ? #f0f5fc : #172b43;
    out property <color> ink: dark ? #cbd5e2 : #34465b;
    out property <color> secondary: dark ? #b0bfd2 : #506278;
    out property <color> muted: dark ? #96a6bc : #596b80;
    out property <color> line: dark ? #354254 : #dbe4ef;
    out property <color> error: dark ? #ffb1a7 : #ac3023;
    out property <color> automatic: dark ? #a6ccff : #275f9d;
    out property <color> automatic-bg: dark ? #24374e : #eaf2fd;
    out property <color> manual: dark ? #91d8d2 : #206b67;
    out property <color> manual-bg: dark ? #203a3b : #e5f3f0;
    out property <color> success: dark ? #a4d9b7 : #2a6a42;
    out property <color> success-bg: dark ? #253d30 : #eaf4ed;
    out property <color> pending: dark ? #e9c484 : #885b17;
    out property <color> pending-bg: dark ? #423622 : #fbf1df;
    out property <color> error-bg: dark ? #482d2d : #fcecea;
    out property <color> token-input: dark ? #94c5ff : #235b99;
    out property <color> token-output: dark ? #ffb366 : #a84d0d;
    out property <color> token-cached: dark ? #c5a6ed : #895db5;
}

