import { Palette } from "std-widgets.slint";
export struct ProjectRow { id: string, name: string, path: string, status: string, running: bool, selected: bool }
export struct TextRow { id: string, location: string, source: string, translation: string, metadata: string, selected: bool }
export struct NamedRow { id: string, name: string, detail: string, enabled: bool }
export struct EngineRow { id: string, name: string, detail: string, enabled: bool, selected: bool }
export struct TermRow { source: string, target: string }
export struct TokenDisplay { text: string, exact: string }
export struct CleanupRow { id: string, title: string, description: string, size: string, selected: bool }

export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> surface: dark ? #171c24 : #ffffff;
    out property <color> background: dark ? #111720 : #f4f7fb;
    out property <color> tint: dark ? #253c55 : #e6f0fc;
    out property <color> accent: dark ? #94c5ff : #235b99;
    out property <color> title: dark ? #f0f5fc : #172b43;
    out property <color> ink: dark ? #cbd5e2 : #34465b;
    out property <color> secondary: dark ? #b0bfd2 : #506278;
    out property <color> muted: dark ? #96a6bc : #596b80;
    out property <color> line: dark ? #354254 : #dbe4ef;
    out property <color> error: dark ? #ffb1a7 : #ac3023;
}

