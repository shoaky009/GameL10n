import { Button, LineEdit, TextEdit, ScrollView, ProgressIndicator } from "std-widgets.slint";
import { App, Theme, Label, Caption, TokenCaption, TokenDisplay, Heading, SectionHeading, Divider, ReportText, Link } from "state.slint";

component RunningTask inherits VerticalLayout {
    in property <string> title;
    in property <string> message;
    in property <string> api;
    in property <TokenDisplay> usage;
    in property <float> progress;
    in property <string> stop-label;
    callback stop();
    private property <bool> expanded;
    spacing: 4px;
    HorizontalLayout { spacing: 10px;
        Label { text: App.project-name; color: Theme.secondary; max-width: 180px; min-width: 0px; overflow: elide; wrap: no-wrap; vertical-alignment: center; }
        Label { text: root.title; color: Theme.ink; min-width: 0px; horizontal-stretch: 1; overflow: elide; wrap: no-wrap; vertical-alignment: center; }
        Button { text: root.stop-label; clicked => { root.stop(); } }
        Button { text: root.expanded ? "收起详情" : "任务详情"; accessible-label: root.title + "详情"; clicked => { root.expanded = !root.expanded; } }
    }
    ProgressIndicator { height: 3px; progress: root.progress; indeterminate: root.progress == 0; }
    if root.expanded: VerticalLayout { spacing: 4px;
        if root.api != "": Caption { text: "API：" + root.api; }
        if root.usage.text != "": TokenCaption { value: root.usage; }
        ScrollView { height: 64px; horizontal-scrollbar-policy: always-off; content-width: self.visible-width;
            ReportText { text: root.message; }
        }
    }
}

export component TaskFeedback inherits Rectangle {
    private property <bool> show-task: App.busy && App.project-id != "";
    private property <bool> show-review: App.review-running && App.project-id != "";
    private property <bool> show-recognition-failure: !App.busy && App.error == "" && App.recognition-failure-message != "";
    height: feedback-content.preferred-height + 20px;
    background: App.error != "" || root.show-recognition-failure ? Theme.error-bg : Theme.automatic-bg;
    border-radius: 5px;
    feedback-content := VerticalLayout { x: 12px; y: 10px; width: parent.width - 24px; height: self.preferred-height; spacing: 6px;
        if root.show-task: RunningTask {
            title: App.status; message: App.task-message; api: App.task-api; usage: App.task-usage; progress: App.progress;
            stop-label: App.task-operation == "translate" || App.task-operation == "retranslate" || App.task-operation == "candidate" ? "暂停翻译" : "停止任务";
            stop => { App.action("cancel", ""); }
        }
        if root.show-task && root.show-review: Divider {}
        if root.show-review: RunningTask {
            title: "正在总结经验"; message: App.review-message;
            api: App.task-api-for("review", App.task-api-summary); usage: App.review-usage;
            stop-label: "停止总结"; stop => { App.action("cancel-review", ""); }
        }
        if App.error != "" || root.show-recognition-failure || App.activity != "": HorizontalLayout { spacing: 10px;
            Label { text: App.page == 0 && App.project-name != "" ? App.project-name : "操作提示"; color: Theme.secondary; max-width: 180px; min-width: 0px; overflow: elide; wrap: no-wrap; vertical-alignment: center; }
            Label { text: App.concise-text(App.error != "" ? App.error : root.show-recognition-failure ? App.recognition-failure-message : App.activity); color: App.error != "" || root.show-recognition-failure ? Theme.error : Theme.ink; min-width: 0px; horizontal-stretch: 1; overflow: elide; wrap: no-wrap; vertical-alignment: center; }
            if App.error != "": Button { text: "查看原因"; clicked => { App.modal = "feedback"; } }
            if root.show-recognition-failure: Button { text: "查看原因"; clicked => { App.action("tab", "0"); } }
            if App.error != "": Button { text: "关闭"; clicked => { App.error = ""; } }
        }
    }
}

export component AdaptationReport inherits VerticalLayout {
    spacing: 16px; alignment: start;
    if App.adaptation-blocker != "": VerticalLayout { spacing: 8px;
        SectionHeading { text: "当前阻碍"; }
        ReportText { text: App.adaptation-blocker; }
    }
    if App.adaptation-summary != "": ReportText { text: App.adaptation-summary; }
    if App.adaptation-next-action != "": VerticalLayout { spacing: 8px;
        SectionHeading { text: "下一步"; color: Theme.accent; }
        ReportText { text: App.adaptation-next-action; }
    }
    if App.adaptation-pending-coverage != "": VerticalLayout { spacing: 8px;
        SectionHeading { text: "尚未覆盖的文字"; color: Theme.pending; }
        ReportText { text: App.adaptation-pending-coverage; }
    }
    if App.adaptation-runtime-checks != "": VerticalLayout { spacing: 8px;
        SectionHeading { text: "游戏运行验证"; color: Theme.pending; }
        ReportText { text: App.adaptation-runtime-checks; }
    }
    if App.adaptation-validation != "": VerticalLayout { spacing: 8px;
        SectionHeading { text: "资源验收"; }
        ReportText { text: App.adaptation-validation; }
    }
    if App.recognition-warnings != "": VerticalLayout { spacing: 8px;
        SectionHeading { text: "支持范围与注意事项"; color: Theme.pending; }
        ReportText { text: App.recognition-warnings; }
    }
    if App.recognition-diagnostics != "": VerticalLayout { spacing: 8px;
        SectionHeading { text: "识别诊断"; }
        ReportText { text: App.recognition-diagnostics; }
    }
}

component RecognitionFailure inherits VerticalLayout {
    spacing: 8px; alignment: start;
    SectionHeading { text: App.recognition-failure-title; color: Theme.error; }
    ReportText { text: App.recognition-failure-message; }
    if App.recognition-failure-next-action != "": ReportText {
        text: "处理方式：" + App.recognition-failure-next-action;
        color: Theme.secondary;
    }
}

component ResultLine inherits HorizontalLayout {
    in property <string> title;
    in property <string> value;
    in property <color> title-color: Theme.muted;
    spacing: 12px;
    Caption { text: root.title; width: 76px; vertical-alignment: top; color: root.title-color; }
    ReportText {
        text: root.value; horizontal-stretch: 1; min-width: 0px;
    }
}

component RecognitionSummary inherits VerticalLayout {
    spacing: 6px;
    if App.recognition-engine != "": HorizontalLayout { spacing: 12px;
        Caption { text: "引擎"; width: 76px; }
        Link { text: App.recognition-engine; horizontal-stretch: 1; clicked => { App.action("open", "adapter"); } }
    }
    if App.recognition-adapter != "": HorizontalLayout { spacing: 12px;
        Caption { text: "适配器版本"; width: 76px; }
        Link { text: App.recognition-adapter; horizontal-stretch: 1; clicked => { App.action("open", "adapter"); } }
    }
    Caption { text: App.recognition; color: Theme.secondary; }
}

component RunningRecognition inherits ScrollView {
    vertical-stretch: 1;
    horizontal-scrollbar-policy: always-off;
    content-width: self.visible-width;
    private property <string> project-key: App.project-id;
    changed project-key => { self.content-y = 0px; }
    VerticalLayout { padding: 8px; spacing: 8px; alignment: start;
        if App.task-api != "": ResultLine { title: "使用 API"; value: App.task-api; }
        ProgressIndicator { height: 3px; indeterminate: true; }
        ResultLine {
            title: "当前步骤";
            value: App.adaptation-progress != "" ? App.adaptation-progress : App.task-message;
        }
        if App.adaptation-notes != "": ResultLine {
            title: "适配进展";
            value: App.adaptation-notes;
        }
        if App.recognition != "": VerticalLayout { spacing: 8px;
            Divider {}
            HorizontalLayout { spacing: 12px; Caption { text: App.recognition-ready ? "已有结果" : "保留文本"; width: 76px; } RecognitionSummary {} }
        }
    }
}

component CompletedRecognition inherits ScrollView {
    vertical-stretch: 1;
    horizontal-scrollbar-policy: always-off;
    content-width: self.visible-width;
    private property <string> project-key: App.project-id;
    changed project-key => { self.content-y = 0px; }
    VerticalLayout { padding: 8px; spacing: 8px; alignment: start;
        if App.recognition-failure-message != "": RecognitionFailure {}
        if App.source-materials-cleared || App.recognition-failure-message != "" || App.adaptation-result-title == "上次适配结果": Caption {
            text: App.source-materials-cleared ? "工作文件已清理，成果已保留" : "已有提取结果仍可用";
        }
        RecognitionSummary {}
        Divider {}
        if App.adaptation-blocker != "": ResultLine { title: "当前阻碍"; title-color: Theme.pending; value: App.adaptation-blocker; }
        if App.adaptation-pending-coverage != "": ResultLine {
            title: "尚未覆盖"; title-color: Theme.pending;
            value: App.adaptation-pending-coverage;
        }
        if App.recognition-warnings != "": ResultLine {
            title: "注意事项"; title-color: Theme.pending;
            value: App.recognition-warnings;
        }
        if App.recognition-diagnostics != "": ResultLine { title: "识别诊断"; value: App.recognition-diagnostics; }
        if App.adaptation-summary != "" && App.adaptation-pending-coverage == "" && App.adaptation-runtime-checks == "" && App.recognition-warnings == "": ResultLine {
            title: "适配结论";
            value: App.adaptation-summary;
        }
        if App.adaptation-validation != "": ResultLine {
            title: "资源验收";
            value: App.adaptation-validation;
        }
        ResultLine {
            title: "待验证项"; title-color: Theme.pending;
            value: App.adaptation-runtime-checks != "" ? App.adaptation-runtime-checks : "中文显示、字体、换行和存档效果仍需进入游戏确认。";
        }
        if App.recognition-failure-message == "": ResultLine {
            title: "下一步";
            value: App.source-materials-cleared ? "可以查看文本、译文或安装已有补丁。重新生成补丁需要重新识别。" : App.adaptation-next-action != "" ? App.adaptation-next-action : "选择少量文本试译，生成并安装补丁后确认效果。";
        }
    }
}

export component Recognition inherits VerticalLayout {
    spacing: 12px;
    HorizontalLayout { spacing: 20px;
        HorizontalLayout { spacing: 8px; horizontal-stretch: 0;
            if App.can-resume-adaptation: Button { text: "继续智能识别"; primary: true; enabled: !App.busy && !App.review-running; clicked => { App.action("resume-adaptation", ""); } }
            Button { text: App.recognition-ready || App.can-resume-adaptation ? "重新识别…" : "识别与适配"; primary: !App.recognition-ready && !App.can-resume-adaptation; enabled: !App.busy; clicked => { App.action("adapt-dialog", ""); } }
            Button { text: App.recognition-ready ? "查看文本并试译" : "查看保留文本"; primary: App.recognition-ready && !App.can-resume-adaptation; enabled: App.recognition != ""; clicked => { App.action("tab", "1"); } }
        }
        Rectangle { width: 1px;
            Rectangle { width: 1px; height: 20px; y: (parent.height - self.height) / 2; background: Theme.line; }
        }
        HorizontalLayout { spacing: 12px; horizontal-stretch: 0;
            Button { text: "总结经验"; enabled: !App.review-running; clicked => { App.action("review", ""); } }
            VerticalLayout { alignment: center; horizontal-stretch: 0;
                HorizontalLayout { spacing: 12px;
                    if App.review-summary != "": Link { text: "查看总结"; clicked => { App.modal = "engine-review"; } }
                    if App.recognition-engine != "" || App.review-summary != "": Link { text: "同类引擎经验"; clicked => { App.action("open", "knowledge"); } }
                }
            }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    if !App.review-running && App.review-message != "": Caption {
        text: App.review-message; wrap: word-wrap;
    }
    HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 10px;
        Rectangle { width: 8px;
            Rectangle { width: 8px; height: 8px; y: (parent.height - self.height) / 2; border-radius: 4px;
                background: App.recognition-running ? Theme.automatic : App.recognition-failure-message != "" ? Theme.error : App.recognition-ready ? App.adaptation-pending-coverage != "" ? Theme.pending : Theme.success : App.recognition != "" ? Theme.pending : Theme.muted;
            }
        }
        Heading {
            text: App.recognition-running ? App.status : App.recognition-failure-message != "" ? "识别未完成" : App.recognition-ready ? App.adaptation-pending-coverage != "" ? "部分文字可试译" : "文本可试译" : App.recognition != "" ? "覆盖待确认" : "等待识别";
            font-size: 18px;
        }
        Rectangle { horizontal-stretch: 1; }
        if App.recognition-running ? App.task-usage.text != "" : App.adaptation-usage.text != "": TokenCaption {
            value: App.recognition-running ? App.task-usage : App.adaptation-usage; color: Theme.secondary;
            max-width: root.width * 0.55; vertical-alignment: center;
        }
        if !App.recognition-running: Link {
            text: "手动执行适配器…"; enabled: !App.busy && !App.review-running;
            clicked => { App.action("project-adapter-dialog", ""); }
        }
    }
    if App.recognition-ready && !App.recognition-running: CompletedRecognition {}
    if App.recognition-running: RunningRecognition {}
    if !App.recognition-ready && !App.recognition-running: report := ScrollView {
        vertical-stretch: 1;
        horizontal-scrollbar-policy: always-off;
        content-width: min(self.visible-width, 960px);
        private property <string> project-key: App.project-id;
        private property <string> result-key: App.adaptation-summary;
        changed project-key => { self.content-y = 0px; }
        changed result-key => { if !App.recognition-running { self.content-y = 0px; } }
        VerticalLayout { padding: 12px; spacing: 16px; alignment: start;
            if App.recognition-failure-message != "": RecognitionFailure {}
            VerticalLayout { spacing: 8px;
                if App.adaptation-result-title == "上次适配结果": Caption { text: App.adaptation-result-title; }
                if App.recognition != "": RecognitionSummary {}
                if App.recognition == "" && App.adaptation-summary == "" && !App.adaptation-running: Caption { text: "识别时先尝试已有适配器，未匹配时自动进入智能适配。智能适配使用项目或全局设置中的分析 API。"; }
            }
            AdaptationReport {}
            if !App.adaptation-running && App.adaptation-notes != "": VerticalLayout { spacing: 8px;
                SectionHeading { text: "最近关键进展"; }
                ReportText { text: App.adaptation-notes; }
            }
            if App.recognition-ready: Caption { text: "可翻译范围以提取结果为准。先选择容易在游戏中找到的文本试译，再检查字体、换行和显示效果。"; }
        }
    }
}

export component PatchPage inherits ScrollView {
    horizontal-scrollbar-policy: always-off; content-width: self.visible-width;
    VerticalLayout { padding: 8px; spacing: 14px; alignment: start;
        Heading { text: "1 · 生成补丁"; font-size: 18px; }
        Label { text: App.patch-summary == "" ? "使用已保存译文生成补丁，不会调用翻译 API。" : App.patch-summary; }
        HorizontalLayout { spacing: 8px;
            Button { text: "生成补丁…"; primary: App.patch-path == ""; enabled: !App.busy && App.recognition != "" && !App.source-materials-cleared; clicked => { App.action("patch-dialog", ""); } }
            Button { text: "查看本次文本"; enabled: App.patch-path != ""; clicked => { App.action("patch-texts", ""); } }
            Button { text: "打开补丁文件"; enabled: App.patch-path != ""; clicked => { App.action("open", "patch"); } }
            Rectangle { horizontal-stretch: 1; }
        }
        if App.patch-path != "": LineEdit { text: App.patch-path; read-only: true; }
        if App.recognition == "" || App.source-materials-cleared: HorizontalLayout { spacing: 12px;
            Caption { text: "生成补丁需要先识别游戏并准备原文资源。"; }
            Link { text: "前往识别"; clicked => { App.action("tab", "0"); } }
            Rectangle { horizontal-stretch: 1; }
        }
        if App.warnings != "": VerticalLayout { spacing: 6px; SectionHeading { text: "补丁注意事项"; color: Theme.pending; } ReportText { text: App.warnings; } }
        Divider {}
        Heading { text: "2 · 安装到游戏"; font-size: 18px; }
        Caption { text: "安装或恢复前请关闭游戏。安装位置：" + App.project-path; }
        HorizontalLayout { spacing: 8px;
            Button { text: "安装汉化补丁…"; primary: App.patch-path != ""; enabled: App.can-install-patch; clicked => { App.modal = "install"; } }
            Button { text: "恢复原版…"; enabled: !App.busy; clicked => { App.action("restore-dialog", ""); } }
            Rectangle { horizontal-stretch: 1; }
        }
        Caption { text: "手动安装可将补丁 files 文件夹中的全部内容复制到游戏目录并覆盖。"; }
        Divider {}
        Heading { text: "3 · 启动与验证"; font-size: 18px; }
        if App.patch-launch != "": Label { text: App.patch-launch; }
        Caption { text: App.launch-summary; }
        HorizontalLayout { spacing: 8px;
            Button { text: "启动游戏"; enabled: !App.busy && App.launch-can-run; clicked => { App.action("launch-game", ""); } }
            Button { text: "运行检查…"; clicked => { App.action("game-check-dialog", ""); } }
            Button { text: "启动设置…"; clicked => { App.action("tab", "3"); } }
            Rectangle { horizontal-stretch: 1; }
        }
        Label { text: App.runtime-check == "" ? "尚未记录游戏内显示结果；结构校验不代表中文显示已经验证。" : App.runtime-check; }
        Caption { text: "运行备注"; }
        TextEdit { text <=> App.runtime-note; height: 76px; }
        Caption { text: "确认试用的是上方这份补丁后记录结果。有问题时先填写说明，再继续修复。"; }
        HorizontalLayout { spacing: 8px;
            Button { text: "效果正常"; enabled: !App.busy && App.patch-path != ""; clicked => { App.action("runtime", "passed"); } }
            Button { text: "有问题，继续修复"; enabled: !App.busy && App.patch-path != ""; clicked => { App.action("runtime", "failed"); } }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}
