        "locator": "StringLiteral:139",
        "resourcePath": "Tiny Rogues_Data/il2cpp_data/Metadata/global-metadata.dat"
      },
      {
        "sourceText": "Gloves",
        "locator": "StringLiteral:5996",
        "resourcePath": "Tiny Rogues_Data/il2cpp_data/Metadata/global-metadata.dat"
      },
      {
        "sourceText": "Helmet",
        "locator": "StringLiteral:6167",
        "resourcePath": "Tiny Rogues_Data/il2cpp_data/Metadata/global-metadata.dat"
      },
      {
        "sourceText": "•Duration: ",
        "locator": "StringLiteral:17747",
        "resourcePath": "Tiny Rogues_Data/il2cpp_data/Metadata/global-metadata.dat"
      },
      {
